---
import AudioControl from '../components/AudioControl.astro'
---

<html lang="en" data-theme="dark">
  <head>
    <title>Tabata</title>
    <meta charset="utf-8" />

    <link rel="icon" type="image/svg+xml" href="/tabata/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.pumpkin.min.css"
    />
    <link rel="manifest" href="/tabata/manifest.json" />

    <!-- SEO Meta Tags -->
    <title>Tabata - Free HIIT Workout App</title>
    <meta
      name="description"
      content="Tabata is a free, user-friendly exercise routine app designed to help you create and manage high-intensity interval training (HIIT) workouts with ease."
    />
    <meta
      name="keywords"
      content="Tabata, HIIT, workout, fitness, exercise, free app"
    />
    <meta name="author" content="Germán Aliprandi" />

    <!-- Open Graph Meta Tags (for social sharing) -->
    <meta property="og:title" content="Tabata - Free HIIT Workout App" />
    <meta
      property="og:description"
      content="Tabata is a free, user-friendly exercise routine app designed to help you create and manage high-intensity interval training (HIIT) workouts with ease."
    />
    <meta
      property="og:image"
      content="https://galiprandi.github.io/tabata/screenshot-1.png"
    />
    <meta property="og:url" content="https://github.com/galiprandi/tabata" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tabata - Free HIIT Workout App" />
    <meta
      name="twitter:description"
      content="Tabata is a free, user-friendly exercise routine app designed to help you create and manage high-intensity interval training (HIIT) workouts with ease."
    />
    <meta
      name="twitter:image"
      content="https://galiprandi.github.io/tabata/screenshot-1.png"
    />
    <meta name="twitter:site" content="@yourtwitterhandle" />

    <meta
      name="google-site-verification"
      content="D_N13fB6QBjfKH01zYgk_Mc-WPm9TPS-6HcqrGzuxpQ"
    />
  </head>
  <body class="prep">
    <main class="main">
      <slot />
    </main>

    <AudioControl />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CZ03PKC275"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        // @ts-ignore
        dataLayer.push(arguments)
      }
      // @ts-ignore
      gtag('js', new Date())
      // @ts-ignore
      gtag('config', 'G-CZ03PKC275')
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color--prep: #052940;
    --color-work: #44aa99;
    --color-rest: #cc6677;
    --color-win: #332288;
    --color-accent: #f7c179;
    --pico-color: white !important;
    --pico-h1-color: white !important;
    --color-links: white;

    /* Override Pico pumpkin dark theme to match training view colors */
    --pico-background-color: #052940;
    --pico-color: #ffffff;
    --pico-muted-color: rgba(255, 255, 255, 0.6);
    --pico-muted-border-color: rgba(255, 255, 255, 0.12);
    --pico-primary: #f7c179;
    --pico-primary-background: #f7c179;
    --pico-primary-border: #f7c179;
    --pico-primary-hover: rgba(247, 193, 121, 0.85);
    --pico-primary-hover-background: rgba(247, 193, 121, 0.85);
    --pico-primary-hover-border: rgba(247, 193, 121, 0.85);
    --pico-primary-focus: rgba(247, 193, 121, 0.4);
    --pico-primary-inverse: #052940;
    --pico-secondary: rgba(255, 255, 255, 0.6);
    --pico-secondary-background: rgba(255, 255, 255, 0.1);
    --pico-secondary-border: rgba(255, 255, 255, 0.12);
    --pico-secondary-hover: rgba(255, 255, 255, 0.15);
    --pico-secondary-hover-background: rgba(255, 255, 255, 0.15);
    --pico-secondary-hover-border: rgba(255, 255, 255, 0.15);
    --pico-secondary-inverse: #ffffff;
    --pico-contrast: #ffffff;
    --pico-contrast-background: rgba(255, 255, 255, 0.08);
    --pico-contrast-border: rgba(255, 255, 255, 0.12);
    --pico-contrast-hover: #ffffff;
    --pico-contrast-hover-background: rgba(255, 255, 255, 0.12);
    --pico-contrast-hover-border: rgba(255, 255, 255, 0.12);
    --pico-contrast-inverse: #ffffff;
    --pico-h1-color: #ffffff;
    --pico-h2-color: #ffffff;
    --pico-h3-color: #ffffff;
    --pico-h4-color: rgba(255, 255, 255, 0.9);
    --pico-h5-color: rgba(255, 255, 255, 0.8);
    --pico-h6-color: rgba(255, 255, 255, 0.7);
    --pico-card-background-color: rgba(255, 255, 255, 0.06);
    --pico-card-border-color: rgba(255, 255, 255, 0.12);
    --pico-form-element-background-color: rgba(0, 0, 0, 0.2);
    --pico-form-element-border-color: rgba(255, 255, 255, 0.12);
    --pico-form-element-color: #ffffff;
    --pico-form-element-placeholder-color: rgba(255, 255, 255, 0.4);
    --pico-form-element-active-background-color: rgba(0, 0, 0, 0.3);
    --pico-form-element-active-border-color: #f7c179;
    --pico-form-element-focus-color: #f7c179;
    --pico-form-element-selected-background-color: rgba(247, 193, 121, 0.2);
    --pico-modal-overlay-background-color: rgba(0, 0, 0, 0.85);
    --pico-modal-overlay-backdrop-filter: blur(8px);
    --pico-progress-background-color: rgba(0, 0, 0, 0.25);
    --pico-progress-color: #f7c179;
    --pico-dropdown-background-color: rgba(10, 15, 25, 0.95);
    --pico-dropdown-border-color: rgba(255, 255, 255, 0.12);
    --pico-dropdown-box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3);
    --pico-switch-background-color: rgba(255, 255, 255, 0.15);
    --pico-switch-checked-background-color: #f7c179;
    --pico-code-background-color: rgba(0, 0, 0, 0.25);
    --pico-mark-background-color: rgba(247, 193, 121, 0.2);
    --pico-mark-color: #ffffff;
    --pico-ins-color: #44aa99;
    --pico-del-color: #cc6677;
    --pico-box-shadow: 0.0145rem 0.029rem 0.174rem rgba(0, 0, 0, 0.1), 0.0625rem 0.125rem 0.75rem rgba(0, 0, 0, 0.15);
    --pico-border-radius: 0.5rem;
    --pico-transition: 0.2s ease-in-out;

    /* Modern UI tokens */
    --surface: rgba(255, 255, 255, 0.06);
    --surface-hover: rgba(255, 255, 255, 0.1);
    --surface-border: rgba(255, 255, 255, 0.12);
    --surface-elevated: rgba(255, 255, 255, 0.08);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --text-primary: white;
    --text-secondary: rgba(255, 255, 255, 0.6);
    --text-muted: rgba(255, 255, 255, 0.4);
    --touch-target: 48px;
    --touch-target-lg: 56px;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body,
  body > main {
    min-height: 100vh;
    min-width: 100vw;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    text-align: center;
    color: var(--text-primary);
    transition: background-color 0.5s;
    overscroll-behavior-y: contain;
  }

  .prep {
    background-color: var(--pico-background-color);
    color: white;
  }

  .workout {
    background-color: var(--color-work);
    color: white;
  }

  .rest {
    background-color: var(--color-rest);
    color: white;
  }

  .win {
    background-color: var(--color-win);
  }

  main {
    width: 100%;
    height: 100%;
    padding: 1.5em;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }

  main > section {
    margin: 0;
  }

  a {
    color: var(--color-links);
    text-decoration-color: var(--color-links);
  }

  .buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5em;
  }

  button > svg {
    margin-right: 0.5em;
  }

  button.icon > svg {
    margin-right: 0;
  }

  /* Accessible touch targets for buttons */
  button,
  .button,
  [role="button"] {
    min-height: var(--touch-target);
    min-width: var(--touch-target);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  a.button {
    --pico-background-color: var(--pico-primary-background);
    --pico-border-color: var(--pico-primary-border);
    --pico-color: var(--pico-primary-inverse);
    --pico-box-shadow: var(--pico-button-box-shadow, 0 0 0 rgba(0, 0, 0, 0));
    padding: var(--pico-form-element-spacing-vertical)
      var(--pico-form-element-spacing-horizontal);
    border: var(--pico-border-width) solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
    outline: 0;
    background-color: var(--pico-background-color);
    box-shadow: var(--pico-box-shadow);
    color: var(--pico-color);
    font-weight: var(--pico-font-weight);
    font-size: 1rem;
    line-height: var(--pico-line-height);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
    transition:
      background-color var(--pico-transition),
      border-color var(--pico-transition),
      color var(--pico-transition),
      box-shadow var(--pico-transition);
  }

  a.button:hover {
    --pico-background-color: var(--pico-primary-hover-background);
    --pico-border-color: var(--pico-primary-hover-border);
    --pico-box-shadow: var(
      --pico-button-hover-box-shadow,
      0 0 0 rgba(0, 0, 0, 0)
    );
    --pico-color: var(--pico-primary-inverse);
  }

  a.button.secondary {
    --pico-background-color: var(--pico-secondary-background);
    --pico-border-color: var(--pico-secondary-border);
    --pico-color: var(--pico-secondary-inverse);
    cursor: pointer;
  }

  a.button.secondary:hover {
    --pico-background-color: var(--pico-secondary-hover-background);
    --pico-border-color: var(--pico-secondary-hover-border);
    --pico-color: var(--pico-secondary-inverse);
  }

  .columns {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Improve readability for landscape/tablets */
  @media (min-width: 768px) {
    :root {
      font-size: 18px;
    }
  }

  @media (min-width: 1200px) {
    :root {
      font-size: 20px;
    }
  }

  progress {
    height: 1.2em;
    padding: 3px;
    margin: 0;
    max-width: 90%;
    border-radius: 8px;
    background-color: hsla(0, 0%, 0%, 0.3);
  }
  progress[value]::-webkit-progress-value {
    margin: auto;
    border-radius: 5px;
  }

  /* Modern card style - reusable across all views */
  .card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .card-elevated {
    background: var(--surface-elevated);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-xl);
    padding: 2rem;
  }

  /* Modern overlay style - reusable for modals */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  /* Modern button styles */
  .btn-modern {
    min-height: var(--touch-target-lg);
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: transform 0.15s, opacity 0.2s;
  }

  .btn-modern:active {
    transform: scale(0.96);
  }

  .btn-modern.primary {
    background: var(--color-accent);
    color: var(--color--prep);
  }

  .btn-modern.secondary {
    background: var(--surface-hover);
    color: var(--text-primary);
    border: 1px solid var(--surface-border);
  }

  .btn-modern.danger {
    background: transparent;
    color: var(--color-rest);
    border: 1px solid var(--color-rest);
  }

  /* Stat label style */
  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stat-value {
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }

  /* Dialog (modal) styling - match modern dark theme */
  dialog[open] {
    background: var(--surface-elevated);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(8px);
    color: var(--text-primary);
  }

  dialog article {
    background: transparent;
    border: 0;
    color: var(--text-primary);
  }

  dialog article header,
  dialog article footer {
    color: var(--text-primary);
  }

  dialog article header h3 {
    color: var(--text-primary);
  }

  /* Input styling - match modern dark theme */
  input:not([type="submit"], [type="button"], [type="reset"], [type="checkbox"], [type="radio"], [type="file"]) {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--surface-border);
    color: var(--text-primary);
    border-radius: var(--radius-sm);
  }

  input:not([type="submit"], [type="button"], [type="reset"], [type="checkbox"], [type="radio"], [type="file"]):focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(247, 193, 121, 0.15);
  }

  input::placeholder {
    color: var(--text-muted);
  }

  /* Select styling */
  select {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--surface-border);
    color: var(--text-primary);
    border-radius: var(--radius-sm);
  }

  /* Table styling */
  table {
    border-color: var(--surface-border);
  }

  td,
  th {
    color: var(--text-primary);
    border-color: var(--surface-border);
  }

  /* Fieldset and label */
  label {
    color: var(--text-secondary);
  }

  /* Heading defaults */
  h1, h2, h3, h4, h5, h6 {
    color: var(--text-primary);
  }

  /* Small text */
  small {
    color: var(--text-secondary);
  }

  /* Pico button overrides for consistency */
  button:not(.btn-modern):not(.btn-pause):not(.action-btn):not(.select):not(.edit):not(.delete):not(.share):not(.up):not(.down):not(.duplicate):not(.btn-open-dialog):not(.btn-close-dialog):not(.icon) {
    border-radius: var(--radius-md);
    transition: transform 0.15s, opacity 0.2s;
  }

  button:not(.btn-modern):not(.btn-pause):not(.action-btn):not(.select):not(.edit):not(.delete):not(.share):not(.up):not(.down):not(.duplicate):not(.btn-open-dialog):not(.btn-close-dialog):not(.icon):active {
    transform: scale(0.96);
  }
</style>

<script>
  import { initTranslation } from '@assets/dictionary'
  import { speechOnTap } from '@assets/domHelpers'
  document.addEventListener('DOMContentLoaded', () => {
    initTranslation()
    speechOnTap()
  })
</script>
