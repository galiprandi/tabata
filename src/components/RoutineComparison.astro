---

<div class="routine-comparison">
  <h3>Routine Comparison</h3>
  <div class="comparison-list"></div>
</div>

<style>
  .routine-comparison {
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .routine-comparison h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .comparison-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .comparison-item {
    padding: 1rem;
    background: var(--surface-elevated);
    border-radius: var(--radius-sm);
    border: 1px solid var(--surface-border);
  }

  .comparison-name {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .comparison-metrics {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
</style>