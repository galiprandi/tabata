---
import TrashIcon from "./TrashIcon.astro";
---

<div class="workout-history">
  <div class="history-header">
    <h2 data-i18n="Workout History">Workout History</h2>
    <button
      class="btn btn-danger"
      data-action="clear"
      data-i18n-title="Clear History"
      data-i18n-aria-label="Clear History"
    >
      <TrashIcon />
      <span data-i18n="Clear History">Clear History</span>
    </button>
  </div>

  <div class="empty-state" style="display: none;">
    <p data-i18n="No workouts recorded yet. Start training to see your history!">
      No workouts recorded yet. Start training to see your history!
    </p>
  </div>

  <div class="history-list"></div>
</div>

<script>
  import { WorkoutLogService } from "../assets/workoutLog";
  import { t } from "../assets/dictionary";

  const logs = WorkoutLogService.getLogs();
  const emptyState = document.querySelector(
    ".workout-history .empty-state",
  ) as HTMLElement;
  const historyList = document.querySelector(
    ".workout-history .history-list",
  ) as HTMLElement;
  const clearButton = document.querySelector(
    '[data-action="clear"]',
  ) as HTMLButtonElement;

  if (logs.length === 0) {
    emptyState!.style.display = "block";
    if (clearButton) {
      clearButton.style.display = "none";
    }
  } else {
    historyList.innerHTML = logs
      .map(
        (log) => `
      <div class="history-item" data-log-id="${log.id}">
        <div class="history-date">
          ${new Date(log.date).toLocaleDateString()}
        </div>
        <div class="history-details">
          <div class="history-routine">${log.routineSnapshot.name}</div>
          <div class="history-exercises">
            ${log.routineSnapshot.exercises.slice(0, 3).join(", ")}
            ${log.routineSnapshot.exercises.length > 3 ? ` +${log.routineSnapshot.exercises.length - 3} ${t("more")}` : ""}
          </div>
        </div>
        <div class="history-duration">
          ${Math.floor(log.duration / 60)}m ${log.duration % 60}s
        </div>
      </div>
    `,
      )
      .join("");
  }

  if (clearButton && logs.length > 0) {
    clearButton.addEventListener("click", () => {
      if (
        confirm(
          t(
            "Are you sure you want to clear all workout history? This cannot be undone.",
          ),
        )
      ) {
        WorkoutLogService.clearLogs();
        window.location.reload();
      }
    });
  }
</script>

<style>
  .workout-history {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .history-header h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text-primary);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    min-height: var(--touch-target);
    transition: all 0.2s;
  }

  .btn:hover {
    background: var(--surface-hover);
  }

  .btn-danger {
    color: var(--color-rest);
    border-color: var(--color-rest);
  }

  .btn-danger:hover {
    background: rgba(204, 102, 119, 0.15);
  }

  .btn svg {
    margin-right: 0.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .history-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--surface-elevated);
    border-radius: var(--radius-md);
    border: 1px solid var(--surface-border);
  }

  .history-date {
    font-size: 0.875rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .history-details {
    flex: 1;
  }

  .history-routine {
    font-weight: 600;
    color: var(--text-primary);
  }

  .history-exercises {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .history-duration {
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
  }
</style>
