<button class="share-progress-btn" data-action="share-progress">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="18" cy="5" r="3"></circle>
    <circle cx="6" cy="12" r="3"></circle>
    <circle cx="18" cy="19" r="3"></circle>
    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
  </svg>
  Share Progress
</button>

<style>
  .share-progress-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: #3b82f6;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.2s;
  }

  .share-progress-btn:hover {
    background: #2563eb;
  }
</style>

<script>
  const button = document.querySelector('.share-progress-btn') as HTMLButtonElement;
  
  if (button) {
    button.addEventListener('click', () => {
      // Dispatch event to parent component
      button.dispatchEvent(new CustomEvent('share-progress'));
    });
  }
</script>