---

<div class="exercise-analysis">
  <h3>Exercise Analysis</h3>
  <div class="exercise-list"></div>
</div>

<style>
  .exercise-analysis {
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .exercise-analysis h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .exercise-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exercise-item {
    padding: 1rem;
    background: var(--surface-elevated);
    border-radius: var(--radius-sm);
    border: 1px solid var(--surface-border);
  }

  .exercise-name {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .exercise-metrics {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .co-occurrences {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
</style>