---
---

<div class="period-comparison">
  <h3>Period Comparison</h3>
  <div class="comparison-controls">
    <select class="period-select" data-period="1">
      <option value="last7">Last 7 days</option>
      <option value="last30">Last 30 days</option>
    </select>
    <select class="period-select" data-period="2">
      <option value="previous7">Previous 7 days</option>
      <option value="previous30">Previous 30 days</option>
    </select>
  </div>
  <div class="comparison-results"></div>
</div>

<style>
  .period-comparison {
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .period-comparison h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .comparison-controls {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .period-select {
    padding: 0.5rem;
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-sm);
    background: var(--surface-elevated);
    font-size: 0.875rem;
    min-height: var(--touch-target);
  }

  .comparison-results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .comparison-metric {
    padding: 1rem;
    background: var(--surface-elevated);
    border-radius: var(--radius-sm);
    border: 1px solid var(--surface-border);
    text-align: center;
  }

  .metric-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .metric-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .metric-delta {
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  .metric-delta.positive {
    color: var(--color-work);
  }

  .metric-delta.negative {
    color: var(--color-rest);
  }
</style>