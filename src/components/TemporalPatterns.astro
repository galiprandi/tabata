---

<div class="temporal-patterns">
  <h3>Temporal Patterns</h3>
  <div class="patterns-grid"></div>
</div>

<style>
  .temporal-patterns {
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .temporal-patterns h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .patterns-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.5rem;
  }

  .pattern-day {
    padding: 1rem;
    background: var(--surface-elevated);
    border-radius: var(--radius-sm);
    border: 1px solid var(--surface-border);
    text-align: center;
  }

  .pattern-day-name {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .pattern-day-count {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pattern-day-percentage {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }
</style>