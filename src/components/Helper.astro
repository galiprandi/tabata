---
import HelpIcon from '@components/HelpIcon.astro'

const { title, description } = Astro.props
---

<button
  title={title}
  class="btn-open-dialog"
  data-title={title}
  data-description={description}
  data-i18n-aria-label="Open help"
>
  <HelpIcon />
</button>

<dialog id="help-modal">
  <article>
    <header>
      <h3 class="title"></h3>
    </header>
    <div class="content">
      <p class="description"></p>
    </div>
    <footer>
      <button
        id="btn-close-dialog"
        data-i18n-title="Close"
        class="contrast"
        data-i18n="Close">Close</button
      >
    </footer>
  </article>
</dialog>

<script>
  import { updateTextContent } from '@assets/main'

  const dialog = document.getElementById(
    'help-modal'
  ) as HTMLDialogElement | null
  const btnOpen = document.querySelectorAll(
    '.btn-open-dialog'
  ) as NodeListOf<HTMLButtonElement> | null
  const btnClose = document.getElementById(
    'btn-close-dialog'
  ) as HTMLButtonElement | null

  if (dialog && btnOpen) {
    btnOpen.forEach(btn => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-title')
        const description = btn.getAttribute('data-description')

        title && updateTextContent('.title', title)
        description && updateTextContent('.description', description)

        dialog.showModal()
      })
    })
  }

  if (dialog && btnClose) {
    btnClose.addEventListener('click', () => {
      dialog.close()
    })
  }
</script>

<style>
  .btn-open-dialog {
    background: 0;
    border: 0;
    outline: 0;
    padding: 0;
    box-shadow: none;
    color: inherit;
    cursor: pointer;
  }

  #help-modal article {
    width: 90vw;
    max-width: 600px;
  }

  #help-modal .content {
    max-height: 50vh;
    overflow-y: auto;
    margin-bottom: 1rem;
  }

  #btn-close-dialog {
    width: 100%;
    min-height: 3.5rem;
    font-size: 1.2rem;
  }

  @media (orientation: landscape) and (max-height: 500px) {
    #help-modal article {
      margin-top: 2rem;
      margin-bottom: 2rem;
    }
  }
</style>
