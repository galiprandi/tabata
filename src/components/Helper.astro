---
import HelpIcon from "@components/HelpIcon.astro";

const { title, description } = Astro.props;
---

<div class="helper-container">
  <button
    title={title}
    class="btn-open-dialog"
    data-title={title}
    data-description={description}
    data-i18n-aria-label="Open help"
    data-i18n-title="Open help"
    data-tooltip={title || "Open help"}
  >
    <HelpIcon />
  </button>
  <dialog class="help-modal">
    <article>
      <header><h3 class="title"></h3></header>
      <div class="content"><p class="description"></p></div>
      <footer>
        <button
          data-i18n-title="Close"
          data-i18n="Close"
          class="contrast btn-close-dialog">Close</button
        >
      </footer>
    </article>
  </dialog>
</div>

<script>
  import { play } from "@assets/audio";

  const containers = document.querySelectorAll(".helper-container");

  containers.forEach((container) => {
    const btnOpen = container.querySelector(
      ".btn-open-dialog",
    ) as HTMLButtonElement | null;
    const dialog = container.querySelector(
      ".help-modal",
    ) as HTMLDialogElement | null;
    const btnClose = container.querySelector(
      ".btn-close-dialog",
    ) as HTMLButtonElement | null;

    if (btnOpen && dialog && btnClose) {
      btnOpen.addEventListener("click", async () => {
        await play("tap", true);
        const title = btnOpen.getAttribute("data-title");
        const description = btnOpen.getAttribute("data-description");

        const titleEl = dialog.querySelector(".title");
        const descEl = dialog.querySelector(".description");

        if (titleEl && title) titleEl.textContent = title;
        if (descEl && description) descEl.textContent = description;

        dialog.showModal();
        btnClose.focus();

        dialog.addEventListener("close", () => btnOpen.focus(), { once: true });
      });

      btnClose.addEventListener("click", async () => {
        await play("tap", true);
        dialog.close();
      });

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) {
          dialog.close();
        }
      });
    }
  });
</script>

<style>
  .btn-open-dialog {
    background: 0;
    border: 0;
    outline: 0;
    padding: 0;
    box-shadow: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s ease-in-out;

    &:hover,
    &:focus-visible {
      opacity: 1;
    }
  }

  .help-modal article {
    width: 90vw;
    max-width: 600px;
    background: var(--surface-elevated);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-xl);
  }

  .help-modal .content {
    max-height: 50vh;
    overflow-y: auto;
    margin-bottom: 1rem;
  }

  .btn-close-dialog {
    width: 100%;
    min-height: var(--touch-target-lg);
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: var(--radius-md);
  }

  @media (orientation: landscape) and (max-height: 500px) {
    #help-modal article {
      margin-top: 2rem;
      margin-bottom: 2rem;
    }
  }
</style>
