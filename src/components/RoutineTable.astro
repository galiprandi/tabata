---
import type { Routine } from '../assets/routine/RoutineTypes';
import QuickActions from './QuickActions.astro';

interface Props {
  routines: Routine[];
}

const { routines } = Astro.props;
---

<div class="routine-table-container">
  <table class="routine-table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Ejercicios</th>
        <th>Tiempos</th>
        <th>Rondas</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {routines.map((routine) => (
        <tr class="routine-row" data-routine-id={routine.id}>
          <td class="routine-name">{routine.name}</td>
          <td class="routine-exercises">
            <div class="exercises-list">
              {routine.exercises.slice(0, 3).map((ex) => (
                <span class="exercise-tag">{ex}</span>
              ))}
              {routine.exercises.length > 3 && (
                <span class="exercise-count">+{routine.exercises.length - 3}</span>
              )}
            </div>
          </td>
          <td class="routine-timing">
            <div class="timing-info">
              <span>Prep: {routine.config.prepDuration}s</span>
              <span>Work: {routine.config.workDuration}s</span>
              <span>Rest: {routine.config.restDuration}s</span>
            </div>
          </td>
          <td class="routine-rounds">{routine.config.rounds}</td>
          <td class="routine-actions">
            <QuickActions routine={routine} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  {routines.length === 0 && (
    <div class="empty-state">
      <p>No hay rutinas. Creá la primera para empezar.</p>
    </div>
  )}
</div>

<style>
  .routine-table-container {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    overflow: hidden;
  }

  .routine-table {
    width: 100%;
    border-collapse: collapse;
  }

  .routine-table thead {
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .routine-table th {
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .routine-table tbody tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: background-color 0.2s;
  }

  .routine-table tbody tr:last-child {
    border-bottom: none;
  }

  .routine-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .routine-table td {
    padding: 1rem;
    vertical-align: middle;
  }

  .routine-name {
    font-weight: 600;
    color: white;
  }

  .exercises-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .exercise-tag {
    background: rgba(68, 170, 153, 0.2);
    color: var(--color-work);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .exercise-count {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .timing-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .routine-rounds {
    font-weight: 600;
    color: white;
    text-align: center;
  }

  .routine-actions {
    text-align: right;
  }

  .empty-state {
    padding: 3rem;
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 768px) {
    .routine-table thead {
      display: none;
    }

    .routine-table,
    .routine-table tbody,
    .routine-table tr,
    .routine-table td {
      display: block;
      width: 100%;
    }

    .routine-table tr {
      padding: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .routine-table td {
      padding: 0.4rem 0;
      text-align: left;
    }

    .routine-actions {
      text-align: left;
      margin-top: 0.5rem;
    }
  }
</style>
