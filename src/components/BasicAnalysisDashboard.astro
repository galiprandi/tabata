---
import BasicKPIsPanel from './BasicKPIsPanel.astro'
import BasicTrendAnalysis from './BasicTrendAnalysis.astro'
import TimelineChart from './TimelineChart.astro'
import AdvancedAnalysisTabs from './AdvancedAnalysisTabs.astro'
import RoutineComparison from './RoutineComparison.astro'
import ExerciseAnalysis from './ExerciseAnalysis.astro'
import TemporalPatterns from './TemporalPatterns.astro'
import PeriodComparison from './PeriodComparison.astro'
import AnalysisToolsPanel from './AnalysisToolsPanel.astro'
---

<div class="basic-analysis-dashboard">
  <h2>Basic Analysis</h2>
  
  <AnalysisToolsPanel />
  
  <div class="dashboard-grid">
    <div class="dashboard-section">
      <BasicKPIsPanel />
    </div>
    
    <div class="dashboard-section">
      <BasicTrendAnalysis />
    </div>
    
    <div class="dashboard-section full-width">
      <TimelineChart />
    </div>
  </div>
  
  <div class="advanced-section">
    <h3>Advanced Analysis</h3>
    <AdvancedAnalysisTabs />
    
    <div class="tab-content" data-tab="routines">
      <RoutineComparison />
    </div>
    
    <div class="tab-content" data-tab="exercises" style="display: none;">
      <ExerciseAnalysis />
    </div>
    
    <div class="tab-content" data-tab="patterns" style="display: none;">
      <TemporalPatterns />
    </div>
    
    <div class="tab-content" data-tab="comparison" style="display: none;">
      <PeriodComparison />
    </div>
  </div>
</div>

<script>
  document.addEventListener('tab-change', (e) => {
    const tab = (e as CustomEvent).detail.tab
    
    // Hide all tab contents
    document.querySelectorAll('.tab-content').forEach((content) => {
      (content as HTMLElement).style.display = 'none'
    })
    
    // Show selected tab content
    const selectedContent = document.querySelector(`[data-tab="${tab}"]`)
    if (selectedContent) {
      (selectedContent as HTMLElement).style.display = 'block'
    }
  })
</script>

<style>
  .basic-analysis-dashboard {
    background: #f8fafc;
    border-radius: 8px;
    padding: 2rem;
  }

  .basic-analysis-dashboard h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 1.5rem;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .dashboard-section {
    min-height: 200px;
  }

  .dashboard-section.full-width {
    grid-column: 1 / -1;
  }

  .advanced-section {
    margin-top: 2rem;
  }

  .advanced-section h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 1rem;
  }

  .tab-content {
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>