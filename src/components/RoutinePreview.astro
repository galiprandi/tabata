---
import type { SharedRoutine } from "../assets/routineSharing";

interface Props {
  routine: SharedRoutine | undefined;
}

const { routine } = Astro.props;
---

<div class="routine-preview">
  <div class="preview-header">
    <h2 data-i18n="Shared Routine">Shared Routine</h2>
    <p class="routine-name">{routine?.name || "Loading..."}</p>
  </div>

  <div class="preview-content">
    <div class="preview-section">
      <h3 data-i18n="Exercises">Exercises</h3>
      <ul class="exercises-list">
        {
          routine?.exercises.map((exercise) => <li>{exercise}</li>) || (
            <li data-i18n="Loading exercises...">Loading exercises...</li>
          )
        }
      </ul>
    </div>

    <div class="preview-section">
      <h3 data-i18n="Timing">Timing</h3>
      <div class="timing-grid">
        <div class="timing-item">
          <span class="label" data-i18n="Prep">Prep</span>
          <span class="value">{routine?.config.prepDuration || 0}s</span>
        </div>
        <div class="timing-item">
          <span class="label" data-i18n="Work">Work</span>
          <span class="value">{routine?.config.workDuration || 0}s</span>
        </div>
        <div class="timing-item">
          <span class="label" data-i18n="Rest">Rest</span>
          <span class="value">{routine?.config.restDuration || 0}s</span>
        </div>
        <div class="timing-item">
          <span class="label" data-i18n="Rounds">Rounds</span>
          <span class="value">{routine?.config.rounds || 0}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="preview-actions">
    <button class="btn btn-cancel" data-action="cancel" data-i18n="Cancel"
      >Cancel</button
    >
    <button class="btn btn-save" data-action="save" data-i18n="Save Routine"
      >Save Routine</button
    >
  </div>
</div>

<style>
  .routine-preview {
    background: var(--surface-elevated);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-xl);
    padding: 2rem;
    max-width: 400px;
    width: 100%;
    backdrop-filter: blur(12px);
  }

  .preview-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .preview-header h2 {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.5rem 0;
  }

  .routine-name {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-accent);
    margin: 0;
  }

  .preview-content {
    margin-bottom: 1.5rem;
  }

  .preview-section {
    margin-bottom: 1.25rem;
  }

  .preview-section h3 {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.75rem 0;
  }

  .exercises-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .exercises-list li {
    padding: 0.625rem 0.875rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-sm);
    margin-bottom: 0.5rem;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .exercises-list li:last-child {
    margin-bottom: 0;
  }

  .timing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .timing-item {
    background: rgba(0, 0, 0, 0.2);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .timing-item .label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .timing-item .value {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .preview-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn {
    flex: 1;
    padding: 0.875rem 1.25rem;
    border: none;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 0.15s,
      opacity 0.2s;
    min-height: var(--touch-target-lg);
  }

  .btn-cancel {
    background: var(--surface-hover);
    color: var(--text-primary);
    border: 1px solid var(--surface-border);
  }

  .btn-cancel:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .btn-save {
    background: var(--color-accent);
    color: var(--color--prep);
  }

  .btn-save:hover {
    opacity: 0.9;
  }

  .btn:active {
    transform: scale(0.96);
  }
</style>

<script>
  import { play } from "../assets/audio";

  const container = document.querySelector(".routine-preview") as HTMLElement;
  const cancelButton = container?.querySelector(
    ".btn-cancel",
  ) as HTMLButtonElement;
  const saveButton = container?.querySelector(".btn-save") as HTMLButtonElement;

  if (cancelButton && container) {
    cancelButton.addEventListener("click", async () => {
      await play("tap", true);
      container.dispatchEvent(new CustomEvent("cancel", { bubbles: true }));
    });
  }

  if (saveButton && container) {
    saveButton.addEventListener("click", async () => {
      await play("tap", true);
      container.dispatchEvent(new CustomEvent("save", { bubbles: true }));
    });
  }

  // Manage auto-focus and scoped keyboard shortcuts when visible
  if (container) {
    container.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        cancelButton?.click();
      } else if (e.key === "Enter") {
        // If focus is already on a button, let the default browser behavior trigger it
        if (document.activeElement instanceof HTMLButtonElement) {
          return;
        }
        e.preventDefault();
        saveButton?.click();
      }
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            saveButton?.focus();
          }
        });
      },
      { threshold: 0.1 },
    );

    observer.observe(container);
  }
</script>
