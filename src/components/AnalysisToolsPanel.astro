---
---

<div class="analysis-tools-panel">
  <button class="panel-toggle" data-action="toggle">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    Herramientas
  </button>

  <div class="panel-content" style="display: none;">
    <div class="tools-tabs">
      <button class="tool-tab active" data-tool="filters">Filtros</button>
      <button class="tool-tab" data-tool="export">Exportar</button>
      <button class="tool-tab" data-tool="annotations">Notas</button>
    </div>

    <div class="tool-content" data-tool="filters">
      <h4>Filtros avanzados</h4>
      <div class="filter-group">
        <label>Rango de fechas</label>
        <div class="date-inputs">
          <input type="date" class="date-input" data-filter="from" />
          <span>→</span>
          <input type="date" class="date-input" data-filter="to" />
        </div>
      </div>
      <div class="filter-group">
        <label>Rutinas</label>
        <select class="filter-select" data-filter="routines" multiple></select>
      </div>
      <div class="filter-group">
        <label>Ejercicios</label>
        <select class="filter-select" data-filter="exercises" multiple></select>
      </div>
      <div class="filter-actions">
        <button class="btn btn-primary" data-action="apply">Aplicar</button>
        <button class="btn btn-secondary" data-action="reset">Limpiar</button>
      </div>
    </div>

    <div class="tool-content" data-tool="export" style="display: none;">
      <h4>Exportar datos</h4>
      <div class="export-group">
        <label>Formato</label>
        <select class="export-select" data-export="format">
          <option value="csv">CSV</option>
          <option value="json">JSON</option>
        </select>
      </div>
      <button class="btn btn-primary" data-action="export">Exportar</button>
    </div>

    <div class="tool-content" data-tool="annotations" style="display: none;">
      <h4>Notas del entrenador</h4>
      <textarea class="annotation-textarea" placeholder="Agregar nota..." rows="3"></textarea>
      <button class="btn btn-primary" data-action="save-note">Guardar nota</button>
      <div class="annotations-items"></div>
    </div>
  </div>
</div>

<style>
  .analysis-tools-panel {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    margin-bottom: 1.5rem;
  }

  .panel-toggle {
    width: 100%;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    color: white;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.2s;
  }

  .panel-toggle:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .panel-content {
    padding: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .tools-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 0.5rem;
  }

  .tool-tab {
    padding: 0.5rem 1rem;
    background: transparent;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    transition: all 0.2s;
  }

  .tool-tab:hover {
    background: rgba(255, 255, 255, 0.08);
    color: white;
  }

  .tool-tab.active {
    background: var(--color-accent);
    color: var(--color--prep);
  }

  h4 {
    font-size: 1rem;
    font-weight: 600;
    color: white;
    margin: 0 0 1rem 0;
  }

  .filter-group,
  .export-group {
    margin-bottom: 1rem;
  }

  .filter-group label,
  .export-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.5rem;
  }

  .date-inputs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .date-input,
  .export-select,
  .filter-select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    font-size: 0.85rem;
    background: rgba(0, 0, 0, 0.2);
    color: white;
  }

  .filter-select {
    min-height: 80px;
  }

  .filter-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .annotation-textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    font-size: 0.85rem;
    font-family: inherit;
    resize: vertical;
    margin-bottom: 0.5rem;
    background: rgba(0, 0, 0, 0.2);
    color: white;
  }

  .annotation-textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .btn {
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    color: white;
    transition: all 0.2s;
    min-height: 48px;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color--prep);
    border-color: var(--color-accent);
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .annotations-items {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .annotation-item {
    padding: 0.75rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .annotation-item-text {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0.4rem;
  }

  .annotation-item-date {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .annotation-item-delete {
    float: right;
    background: none;
    border: none;
    color: var(--color-rest);
    cursor: pointer;
    font-size: 0.8rem;
    padding: 0;
  }
</style>

<script>
  import { WorkoutLogService } from '../assets/workoutLog'
  import { applyFilters, exportToCSV, exportToJSON, saveNote, getNotes, deleteNote } from '../assets/analysisTools'
  import type { FilterState } from '../assets/analysisTools'

  const toggleButton = document.querySelector('[data-action="toggle"]') as HTMLButtonElement
  const panelContent = document.querySelector('.panel-content') as HTMLElement
  const toolTabs = document.querySelectorAll('.tool-tab') as NodeListOf<HTMLButtonElement>

  if (toggleButton && panelContent) {
    toggleButton.addEventListener('click', () => {
      const isHidden = panelContent.style.display === 'none'
      panelContent.style.display = isHidden ? 'block' : 'none'
    })
  }

  toolTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      toolTabs.forEach((t) => t.classList.remove('active'))
      tab.classList.add('active')

      const tool = tab.dataset.tool

      document.querySelectorAll('.tool-content').forEach((content) => {
        (content as HTMLElement).style.display = 'none'
      })

      const selectedContent = document.querySelector(`.tool-content[data-tool="${tool}"]`)
      if (selectedContent) {
        (selectedContent as HTMLElement).style.display = 'block'
      }
    })
  })

  // Populate filter selects with real data
  function populateFilterSelects() {
    const logs = WorkoutLogService.getLogs()
    const routines = [...new Set(logs.map((log) => log.routineSnapshot.name))]
    const exercises = [...new Set(logs.flatMap((log) => log.routineSnapshot.exercises))]

    const routinesSelect = document.querySelector('[data-filter="routines"]') as HTMLSelectElement
    const exercisesSelect = document.querySelector('[data-filter="exercises"]') as HTMLSelectElement

    if (routinesSelect) {
      routinesSelect.innerHTML = routines.map((r) => `<option value="${r}">${r}</option>`).join('')
    }
    if (exercisesSelect) {
      exercisesSelect.innerHTML = exercises.map((e) => `<option value="${e}">${e}</option>`).join('')
    }
  }

  populateFilterSelects()

  // Apply filters
  const applyBtn = document.querySelector('[data-action="apply"]') as HTMLButtonElement
  if (applyBtn) {
    applyBtn.addEventListener('click', () => {
      const fromInput = document.querySelector('[data-filter="from"]') as HTMLInputElement
      const toInput = document.querySelector('[data-filter="to"]') as HTMLInputElement
      const routinesSelect = document.querySelector('[data-filter="routines"]') as HTMLSelectElement
      const exercisesSelect = document.querySelector('[data-filter="exercises"]') as HTMLSelectElement

      const filters: FilterState = {}

      if (fromInput?.value && toInput?.value) {
        filters.dateRange = {
          from: new Date(fromInput.value).getTime(),
          to: new Date(toInput.value).getTime(),
        }
      }

      if (routinesSelect?.selectedOptions.length) {
        filters.routines = Array.from(routinesSelect.selectedOptions).map((o) => o.value)
      }

      if (exercisesSelect?.selectedOptions.length) {
        filters.exercises = Array.from(exercisesSelect.selectedOptions).map((o) => o.value)
      }

      const logs = WorkoutLogService.getLogs()
      const filtered = applyFilters(logs, filters)

      document.dispatchEvent(new CustomEvent('filters-applied', {
        detail: { filteredLogs: filtered }
      }))
    })
  }

  // Reset filters
  const resetBtn = document.querySelector('[data-action="reset"]') as HTMLButtonElement
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      const fromInput = document.querySelector('[data-filter="from"]') as HTMLInputElement
      const toInput = document.querySelector('[data-filter="to"]') as HTMLInputElement
      const routinesSelect = document.querySelector('[data-filter="routines"]') as HTMLSelectElement
      const exercisesSelect = document.querySelector('[data-filter="exercises"]') as HTMLSelectElement

      if (fromInput) fromInput.value = ''
      if (toInput) toInput.value = ''
      if (routinesSelect) Array.from(routinesSelect.options).forEach((o) => o.selected = false)
      if (exercisesSelect) Array.from(exercisesSelect.options).forEach((o) => o.selected = false)

      const logs = WorkoutLogService.getLogs()
      document.dispatchEvent(new CustomEvent('filters-applied', {
        detail: { filteredLogs: logs }
      }))
    })
  }

  // Export
  const exportBtn = document.querySelector('[data-action="export"]') as HTMLButtonElement
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const formatSelect = document.querySelector('[data-export="format"]') as HTMLSelectElement
      const format = formatSelect?.value || 'csv'
      const logs = WorkoutLogService.getLogs()

      if (format === 'csv') {
        exportToCSV(logs)
      } else {
        exportToJSON(logs)
      }
    })
  }

  // Annotations
  function renderAnnotations() {
    const container = document.querySelector('.annotations-items')
    if (!container) return

    const notes = getNotes()
    if (notes.length === 0) {
      container.innerHTML = '<p style="color: rgba(255,255,255,0.4); font-size: 0.85rem;">Sin notas</p>'
      return
    }

    container.innerHTML = notes.map((note) => `
      <div class="annotation-item" data-note-id="${note.id}">
        <button class="annotation-item-delete" data-action="delete-note" data-note-id="${note.id}">✕</button>
        <div class="annotation-item-text">${note.text}</div>
        <div class="annotation-item-date">${new Date(note.date).toLocaleDateString()}</div>
      </div>
    `).join('')

    container.querySelectorAll('[data-action="delete-note"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const noteId = (btn as HTMLButtonElement).dataset.noteId
        if (noteId) {
          deleteNote(noteId)
          renderAnnotations()
        }
      })
    })
  }

  renderAnnotations()

  const saveNoteBtn = document.querySelector('[data-action="save-note"]') as HTMLButtonElement
  if (saveNoteBtn) {
    saveNoteBtn.addEventListener('click', () => {
      const textarea = document.querySelector('.annotation-textarea') as HTMLTextAreaElement
      if (!textarea || !textarea.value.trim()) return

      saveNote({
        id: crypto.randomUUID(),
        studentId: 'local',
        date: Date.now(),
        text: textarea.value.trim(),
        analysisContext: {
          dateRange: { from: 0, to: Date.now() },
          filters: {},
        },
      })

      textarea.value = ''
      renderAnnotations()
    })
  }
</script>
