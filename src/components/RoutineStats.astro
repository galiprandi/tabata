---

<div class="routine-stats">
  <h2 data-i18n="Routine Statistics">Routine Statistics</h2>

  <div class="empty-state" style="display: none;">
    <p data-i18n="No workout data yet.">No workout data yet.</p>
  </div>

  <div class="stats-list"></div>
</div>

<script>
  import { WorkoutLogService } from "../assets/workoutLog";
  import { t } from "../assets/dictionary";

  const container = document.querySelector('.routine-stats') as HTMLElement;
  if (container) {
    const routineStats = WorkoutLogService.getRoutineStats();
    const emptyState = container.querySelector('.empty-state') as HTMLElement
    const statsList = container.querySelector('.stats-list') as HTMLElement

    if (routineStats.length === 0) {
      if (emptyState) emptyState.style.display = "block";
    } else {
      if (statsList) {
        statsList.innerHTML = routineStats
          .map(
            (stat) => `
          <div class="stat-item">
            <div class="stat-name">${stat.name}</div>
            <div class="stat-metrics">
              <div class="metric">
                <span class="metric-label">${t("Workouts:")}</span>
                <span class="metric-value">${stat.count}</span>
              </div>
              <div class="metric">
                <span class="metric-label">${t("Total Time")}:</span>
                <span class="metric-value">${Math.floor(stat.totalDuration / 60)}m</span>
              </div>
              <div class="metric">
                <span class="metric-label">${t("Avg:")}</span>
                <span class="metric-value">${Math.floor(stat.averageDuration / 60)}m</span>
              </div>
            </div>
            <div class="stat-progress">
              <div class="progress-bar" style="width: ${Math.min((stat.count / 10) * 100, 100)}%"></div>
            </div>
          </div>
        `,
          )
          .join("");
      }
    }
  }
</script>

<style>
  .routine-stats {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .routine-stats h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--text-secondary);
  }

  .stats-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stat-item {
    padding: 1rem;
    background: var(--surface-elevated);
    border-radius: var(--radius-md);
    border: 1px solid var(--surface-border);
  }

  .stat-name {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .stat-metrics {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .metric {
    display: flex;
    gap: 0.25rem;
    font-size: 0.875rem;
  }

  .metric-label {
    color: var(--text-secondary);
  }

  .metric-value {
    font-weight: 600;
    color: var(--text-primary);
  }

  .stat-progress {
    height: 4px;
    background: var(--surface-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: var(--color-accent);
    transition: width 0.3s;
  }
</style>