---
---

<div class="annotations-list">
  <h4>Annotations</h4>
  
  <div class="annotations-search">
    <input 
      type="text" 
      class="search-input" 
      data-action="search"
      placeholder="Search annotations..."
    />
  </div>
  
  <div class="annotations-items"></div>
</div>

<style>
  .annotations-list h4 {
    font-size: 1rem;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 1rem;
  }

  .annotations-search {
    margin-bottom: 1rem;
  }

  .search-input {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 0.875rem;
  }

  .annotations-items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .annotation-item {
    padding: 1rem;
    background: #fef9c3;
    border-radius: 6px;
    border: 1px solid #fde047;
  }

  .annotation-date {
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 0.5rem;
  }

  .annotation-text {
    font-size: 0.875rem;
    color: #1e293b;
    margin-bottom: 0.5rem;
  }

  .annotation-actions {
    display: flex;
    gap: 0.5rem;
  }

  .annotation-action {
    padding: 0.25rem 0.5rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .annotation-action:hover {
    background: #f8fafc;
  }

  .annotation-action.delete {
    color: #ef4444;
    border-color: #ef4444;
  }
</style>