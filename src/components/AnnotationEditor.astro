---

<div class="annotation-editor">
  <h4>Add Annotation</h4>
  
  <textarea 
    class="annotation-textarea" 
    data-action="text"
    placeholder="Add your feedback or notes..."
    rows="4"
  ></textarea>
  
  <div class="annotation-context">
    <span class="context-label">Context:</span>
    <span class="context-value" data-context="date-range">Last 7 days</span>
  </div>
  
  <div class="annotation-actions">
    <button class="btn btn-primary" data-action="save">Save</button>
    <button class="btn btn-secondary" data-action="cancel">Cancel</button>
  </div>
</div>

<style>
  .annotation-editor h4 {
    font-size: 1rem;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 1rem;
  }

  .annotation-textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 0.875rem;
    font-family: inherit;
    resize: vertical;
    margin-bottom: 0.5rem;
  }

  .annotation-context {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #64748b;
    margin-bottom: 1rem;
  }

  .context-label {
    font-weight: 500;
  }

  .annotation-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn {
    padding: 0.5rem 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background: white;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #3b82f6;
    color: white;
    border-color: #3b82f6;
  }

  .btn-primary:hover {
    background: #2563eb;
  }

  .btn-secondary:hover {
    background: #f8fafc;
  }
</style>