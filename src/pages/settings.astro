---
import Layout from '@app/layouts/layout.astro'
import SettingsTimerConfig from '@components/SettingsTimerConfig.astro'
import RoutineList from '@components/RoutineList.astro'
import SettingsRoutineList from '@components/SettingsRoutineList.astro'
import GoToHome from '@components/GoToHome.astro'
import GoToTrain from '@components/GoToTrain.astro'
import GoToHistory from '@components/GoToHistory.astro'
---

<Layout>
  <div class="columns">
    <SettingsTimerConfig vertical={true} />
    <div class="routine-section">
      <RoutineList />
      <SettingsRoutineList />
    </div>
  </div>

  <div class="buttons">
    <GoToHome />
    <GoToHistory />
    <GoToTrain />
  </div>
</Layout>

<script>
  import { onClick } from '@assets/domHelpers'

  document.addEventListener('DOMContentLoaded', () => {
    onClick('#btn-routine-start', () => {
      window.location.href = '/tabata/start'
    })
  })
</script>

<style>
  .columns {
    display: grid;
    grid-template-areas: 'settings routine';
    grid-template-columns: 9em 1fr;
    gap: 1.5em;
    align-items: start;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  .routine-section {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }

  .buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1rem;
  }

  @media (width <= 450px) {
    .columns {
      grid-template-columns: 1fr;
      grid-template-areas:
        'settings'
        'routine';
    }
  }
</style>
