---
import Layout from "../layouts/layout.astro";
import GoToHome from "@components/GoToHome.astro";
import SearchBar from "@components/SearchBar.astro";
---

<Layout>
  <nav class="top-nav">
    <GoToHome />
    <h1 data-i18n="Trainer">Trainer</h1>
    <span class="nav-spacer"></span>
  </nav>

  <section class="trainer-content">
    <div class="toolbar">
      <SearchBar />
      <button
        class="btn-create"
        data-action="create"
        data-i18n-title="Add new routine"
        data-i18n-aria-label="Add new routine"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span data-i18n="New Routine">New Routine</span>
      </button>
    </div>

    <div id="routine-list" class="routine-list"></div>

    <div id="empty-state" class="empty-state">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"
        ></path>
        <circle cx="12" cy="13" r="3"></circle>
      </svg>
      <p data-i18n="No routines. Create the first one to start.">
        No routines. Create the first one to start.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { RoutineStorageService } from "../assets/routine";
  import { compressRoutine } from "../assets/routineSharing";
  import type { Routine } from "../assets/routine/RoutineTypes";
  import { t, initTranslation } from "../assets/dictionary";
  import { play } from "../assets/audio";

  function escapeHtml(str: string): string {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  function renderRoutines(routinesToRender: Routine[]) {
    const list = document.getElementById("routine-list");
    const emptyState = document.getElementById("empty-state");
    if (!list || !emptyState) return;

    if (routinesToRender.length === 0) {
      list.innerHTML = "";
      emptyState.style.display = "flex";
      return;
    }

    emptyState.style.display = "none";
    list.innerHTML = routinesToRender
      .map((routine: Routine) => {
        const exercises = routine.exercises
          .slice(0, 4)
          .map(
            (ex: string) =>
              `<span class="exercise-tag">${escapeHtml(ex)}</span>`,
          )
          .join("");
        const extra =
          routine.exercises.length > 4
            ? `<span class="exercise-count">+${routine.exercises.length - 4}</span>`
            : "";

        return `
        <article class="routine-card" data-routine-id="${routine.id}">
          <header class="card-header">
            <h2 class="routine-name">${escapeHtml(routine.name)}</h2>
            <div class="quick-actions" data-routine-id="${routine.id}">
              <button class="action-btn share-btn" data-action="share" data-i18n-title="Share routine" data-i18n-aria-label="Share routine">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="18" cy="5" r="3"></circle>
                  <circle cx="6" cy="12" r="3"></circle>
                  <circle cx="18" cy="19" r="3"></circle>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
              </button>
              <button class="action-btn edit-btn" data-action="edit" data-i18n-title="Edit routine" data-i18n-aria-label="Edit routine">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </button>
              <button class="action-btn delete-btn" data-action="delete" data-i18n-title="Delete routine" data-i18n-aria-label="Delete routine">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>
          </header>

          <div class="card-body">
            <div class="exercises-list">
              ${exercises}${extra}
            </div>
            <div class="timing-grid">
              <div class="timing-item">
                <span class="timing-label">Prep</span>
                <span class="timing-value">${routine.config.prepDuration}s</span>
              </div>
              <div class="timing-item">
                <span class="timing-label">Work</span>
                <span class="timing-value">${routine.config.workDuration}s</span>
              </div>
              <div class="timing-item">
                <span class="timing-label">Rest</span>
                <span class="timing-value">${routine.config.restDuration}s</span>
              </div>
              <div class="timing-item">
                <span class="timing-label" data-i18n="Rounds">Rounds</span>
                <span class="timing-value">${routine.config.rounds}</span>
              </div>
            </div>
          </div>
        </article>
      `;
      })
      .join("");
    initTranslation(list);
  }

  function filterRoutines(query: string) {
    const allRoutines = RoutineStorageService.getRoutines();
    let filtered = allRoutines;

    if (query.trim()) {
      const q = query.toLowerCase();
      filtered = allRoutines.filter(
        (r) =>
          r.name.toLowerCase().includes(q) ||
          r.exercises.some((ex) => ex.toLowerCase().includes(q)),
      );
    }

    renderRoutines(filtered);
  }

  async function handleShare(routineId: string) {
    await play("tap", true);
    const routine = RoutineStorageService.getRoutines().find(
      (r) => r.id === routineId,
    );
    if (!routine) return;

    const result = compressRoutine(routine);
    if (result.success && result.url) {
      navigator.clipboard.writeText(result.url);
      alert(t("Link copied to clipboard"));
    } else {
      alert(t("Failed to generate link"));
    }
  }

  async function handleEdit(routineId: string) {
    await play("tap", true);
    window.location.href = `/tabata/settings?edit=${routineId}`;
  }

  async function handleDelete(routineId: string) {
    await play("tap", true);
    const routine = RoutineStorageService.getRoutines().find(
      (r) => r.id === routineId,
    );
    if (
      routine &&
      confirm(
        t('Are you sure you want to delete "{name}"?').replace(
          "{name}",
          routine.name,
        ),
      )
    ) {
      RoutineStorageService.deleteRoutine(routineId);
      renderRoutines(RoutineStorageService.getRoutines());
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    renderRoutines(RoutineStorageService.getRoutines());

    document.addEventListener("search", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      filterRoutines(detail.query);
    });

    const routineList = document.getElementById("routine-list");
    if (routineList) {
      routineList.addEventListener("click", async (e: Event) => {
        const target = e.target as HTMLElement;
        const btn = target.closest(".action-btn") as HTMLButtonElement | null;
        if (!btn) return;
        const actions = btn.closest(".quick-actions");
        const routineId = actions?.getAttribute("data-routine-id");
        const action = btn.getAttribute("data-action");
        if (!routineId) return;

        if (action === "share") await handleShare(routineId);
        else if (action === "edit") await handleEdit(routineId);
        else if (action === "delete") await handleDelete(routineId);
      });
    }

    const createBtn = document.querySelector('[data-action="create"]');
    if (createBtn) {
      createBtn.addEventListener("click", async () => {
        await play("tap", true);
        window.location.href = "/tabata/settings";
      });
    }
  });
</script>

<style>
  .top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0;
    margin-bottom: 1rem;
  }

  .top-nav h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    color: white;
  }

  .nav-spacer {
    width: 48px;
  }

  .trainer-content {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
  }

  .btn-create {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color--prep);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      opacity 0.2s,
      transform 0.1s;
    min-height: var(--touch-target-lg);
  }

  .btn-create:hover {
    opacity: 0.9;
  }

  .btn-create:active {
    transform: scale(0.97);
  }

  .routine-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .routine-card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .routine-card:hover {
    border-color: var(--color-accent);
    background: var(--surface-hover);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .routine-name {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: white;
    word-break: break-word;
  }

  .quick-actions {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }

  .action-btn:hover {
    background: var(--surface-hover);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .action-btn:active {
    transform: scale(0.93);
  }

  .share-btn:hover {
    color: var(--color-work);
    border-color: var(--color-work);
  }

  .edit-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .delete-btn:hover {
    color: var(--color-rest);
    border-color: var(--color-rest);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exercises-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .exercise-tag {
    background: rgba(68, 170, 153, 0.2);
    color: var(--color-work);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .exercise-count {
    background: var(--surface-hover);
    color: var(--text-secondary);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .timing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .timing-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.6rem 0.4rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-sm);
  }

  .timing-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .timing-value {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .empty-state {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 3rem 1rem;
    color: var(--text-muted);
    text-align: center;
  }

  .empty-state svg {
    opacity: 0.4;
  }

  .empty-state p {
    font-size: 1rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .routine-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .routine-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
