---
import Layout from "../layouts/layout.astro";
import GoToHome from "@components/GoToHome.astro";
import SearchBar from "@components/SearchBar.astro";
---

<Layout>
  <nav class="top-nav">
    <GoToHome />
    <h1 data-i18n="Trainer">Trainer</h1>
    <span class="nav-spacer"></span>
  </nav>

  <section class="trainer-content">
    <div class="trainer-desktop-layout">
      <!-- Left Column: The Library -->
      <aside class="library-panel">
        <div class="toolbar">
          <SearchBar />
          <button
            class="btn-create"
            id="btn-new-routine"
            data-action="create"
            title="Add new routine"
            aria-label="Add new routine"
            data-i18n-title="Add new routine"
            data-i18n-aria-label="Add new routine"
            data-tooltip="Add new routine"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span data-i18n="New Routine">New Routine</span>
          </button>
        </div>

        <div id="routine-list" class="routine-list"></div>

        <div id="empty-state" class="empty-state">
          <div id="no-routines-msg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"
              ></path>
              <circle cx="12" cy="13" r="3"></circle>
            </svg>
            <p data-i18n="No routines. Create the first one to start.">
              No routines. Create the first one to start.
            </p>
          </div>
          <div id="no-results-msg" style="display: none;">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <p data-i18n="No results found for your search">
              No results found for your search
            </p>
            <button
              class="btn-modern secondary outline"
              id="btn-clear-search-empty"
              data-i18n="Clear search"
            >
              Clear search
            </button>
          </div>
        </div>
      </aside>

      <!-- Right Column: Interactive Editor / Viewer -->
      <main class="editor-panel card-elevated" id="editor-panel">
        <!-- Placeholder when no routine is selected -->
        <div id="editor-placeholder" class="editor-placeholder">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="64"
            height="64"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="placeholder-icon"
          >
            <path
              d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
            ></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            <line x1="9" y1="12" x2="15" y2="12"></line>
            <line x1="9" y1="16" x2="15" y2="16"></line>
            <line x1="9" y1="8" x2="12" y2="8"></line>
          </svg>
          <h3 data-i18n="No routine selected">No routine selected</h3>
          <p
            data-i18n="Select a routine from the list or create a new one to begin."
          >
            Select a routine from the list or create a new one to begin.
          </p>
        </div>

        <!-- Form content when routine selected -->
        <div id="editor-content" class="editor-content" style="display: none;">
          <header class="editor-header">
            <h2 id="editor-title" data-i18n="Edit Routine">Edit Routine</h2>
            <div class="editor-header-actions">
              <button
                id="editor-btn-share"
                type="button"
                class="action-btn share-btn"
                title="Share routine"
                aria-label="Share routine"
                data-i18n-title="Share routine"
                data-i18n-aria-label="Share routine"
                data-tooltip="Share routine"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="18" cy="5" r="3"></circle>
                  <circle cx="6" cy="12" r="3"></circle>
                  <circle cx="18" cy="19" r="3"></circle>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
              </button>
              <button
                id="editor-btn-delete"
                type="button"
                class="action-btn delete-btn"
                title="Delete routine"
                aria-label="Delete routine"
                data-i18n-title="Delete routine"
                data-i18n-aria-label="Delete routine"
                data-tooltip="Delete routine"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="3 6 5 6 21"></polyline>
                  <path
                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                  ></path>
                </svg>
              </button>
            </div>
          </header>

          <form id="editor-form">
            <!-- Name -->
            <div class="form-group">
              <label for="editor-routine-name" data-i18n="Routine Name"
                >Routine Name</label
              >
              <input
                type="text"
                id="editor-routine-name"
                required
                placeholder="e.g., Full Body, Cardio"
                data-i18n-placeholder="e.g., Full Body, Cardio"
              />
            </div>

            <!-- Timings -->
            <h3 class="section-title" data-i18n="Timing">Timing</h3>
            <div class="timings-grid-inputs">
              <div class="input-field">
                <label for="editor-prep" data-i18n="Prep">Prep</label>
                <input type="number" id="editor-prep" min="0" required />
              </div>
              <div class="input-field">
                <label for="editor-work" data-i18n="Work">Work</label>
                <input type="number" id="editor-work" min="0" required />
              </div>
              <div class="input-field">
                <label for="editor-rest" data-i18n="Rest">Rest</label>
                <input type="number" id="editor-rest" min="0" required />
              </div>
              <div class="input-field">
                <label for="editor-rounds" data-i18n="Rounds">Rounds</label>
                <input type="number" id="editor-rounds" min="1" required />
              </div>
            </div>

            <!-- Exercises -->
            <div class="exercises-section-header">
              <h3 class="section-title" data-i18n="Exercises">Exercises</h3>
              <span class="badge" id="exercises-badge">0</span>
            </div>

            <!-- Add Exercise Bar -->
            <div class="add-exercise-bar">
              <input
                type="text"
                id="new-exercise-input"
                placeholder="New Exercise"
                aria-label="New Exercise"
                data-i18n-placeholder="New Exercise"
                data-i18n-aria-label="New Exercise"
              />
              <button
                type="button"
                id="btn-add-exercise"
                class="btn-create"
                title="Add Exercise"
                aria-label="Add Exercise"
                data-i18n-title="Add Exercise"
                data-i18n-aria-label="Add Exercise"
                data-tooltip="Add Exercise"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span data-i18n="Exercise">Exercise</span>
              </button>
            </div>

            <!-- Exercises List Container -->
            <div id="editor-exercises-list" class="editor-exercises-list"></div>

            <!-- Switch to Set Active -->
            <div class="active-setting-checkbox">
              <label class="checkbox-label">
                <input type="checkbox" id="editor-is-active" role="switch" />
                <span data-i18n="Set as Active?">Set as Active?</span>
              </label>
            </div>

            <!-- Action buttons -->
            <div class="editor-footer">
              <button
                type="button"
                id="editor-btn-cancel"
                class="btn-modern secondary"
                data-i18n="Cancel"
              >
                Cancel
              </button>
              <button
                type="submit"
                id="editor-btn-save"
                class="btn-modern primary"
                data-i18n="Save"
              >
                Save
              </button>
            </div>
          </form>
        </div>
      </main>
    </div>
  </section>

  <!-- Dialog to edit exercise name -->
  <dialog id="exercise-modal">
    <article>
      <header>
        <h3 id="exercise-modal-title" data-i18n="Edit Exercise">
          Edit Exercise
        </h3>
      </header>
      <form id="exercise-modal-form">
        <fieldset>
          <label for="exercise-modal-input" data-i18n="Exercise Name"
            >Exercise Name</label
          >
          <input type="text" id="exercise-modal-input" required />
        </fieldset>
        <div class="form-buttons">
          <button
            type="button"
            class="secondary"
            id="exercise-modal-cancel"
            data-i18n="Cancel"
          >
            Cancel
          </button>
          <button type="submit" class="primary" data-i18n="Save">Save</button>
        </div>
      </form>
    </article>
  </dialog>
</Layout>

<script>
  import { RoutineStorageService } from "../assets/routine";
  import { compressRoutine } from "../assets/routineSharing";
  import type { Routine } from "../assets/routine/RoutineTypes";
  import { t, initTranslation } from "../assets/dictionary";
  import { play } from "../assets/audio";

  function escapeHtml(str: string): string {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  // --- STATE MANAGEMENT ---
  let selectedRoutineId: string | null = null;
  let currentEditingRoutine: Routine | null = null;
  let exercisesState: string[] = [];
  let searchQuery: string = "";

  // Exercise Edit Modal State
  let activeEditingExerciseIndex: number | null = null;
  const exerciseModal = document.getElementById(
    "exercise-modal",
  ) as HTMLDialogElement | null;
  const exerciseModalInput = document.getElementById(
    "exercise-modal-input",
  ) as HTMLInputElement | null;
  const exerciseModalForm = document.getElementById(
    "exercise-modal-form",
  ) as HTMLFormElement | null;

  // --- RENDERING ROUTINES LIST (LEFT PANEL) ---
  function renderRoutines() {
    const list = document.getElementById("routine-list");
    const emptyState = document.getElementById("empty-state");
    const noRoutinesMsg = document.getElementById("no-routines-msg");
    const noResultsMsg = document.getElementById("no-results-msg");

    if (!list || !emptyState || !noRoutinesMsg || !noResultsMsg) return;

    const allRoutines = RoutineStorageService.getRoutines();
    let routinesToRender = allRoutines;

    const isSearch = searchQuery.trim().length > 0;
    if (isSearch) {
      const q = searchQuery.toLowerCase();
      routinesToRender = allRoutines.filter(
        (r) =>
          r.name.toLowerCase().includes(q) ||
          r.exercises.some((ex) => ex.toLowerCase().includes(q)),
      );
    }

    if (routinesToRender.length === 0) {
      list.innerHTML = "";
      emptyState.style.display = "flex";
      if (isSearch) {
        noRoutinesMsg.style.display = "none";
        noResultsMsg.style.display = "block";
      } else {
        noRoutinesMsg.style.display = "block";
        noResultsMsg.style.display = "none";
      }
      return;
    }

    emptyState.style.display = "none";
    list.innerHTML = routinesToRender
      .map((routine: Routine) => {
        const exercises = routine.exercises
          .slice(0, 4)
          .map(
            (ex: string) =>
              `<span class="exercise-tag">${escapeHtml(ex)}</span>`,
          )
          .join(" ");
        const extra =
          routine.exercises.length > 4
            ? `<span class="exercise-count">+${routine.exercises.length - 4}</span>`
            : "";

        const isActiveCard =
          routine.id === selectedRoutineId ? "active-card" : "";

        const cardAriaLabel = `${escapeHtml(routine.name)}, ${routine.config.rounds} ${t("Rounds").toLowerCase()}, ${routine.exercises.length} ${t("Exercises").toLowerCase()}`;

        return `
        <article class="routine-card ${isActiveCard}" data-routine-id="${routine.id}" tabindex="0" role="button" aria-pressed="${routine.id === selectedRoutineId ? "true" : "false"}" aria-label="${cardAriaLabel}">
          <header class="card-header">
            <h2 class="routine-name">${escapeHtml(routine.name)}</h2>
          </header>

          <div class="card-body">
            <div class="exercises-list">
              ${exercises}${extra}
            </div>
            <div class="timing-grid">
              <div class="timing-item">
                <span class="timing-label">Prep</span>
                <span class="timing-value">${routine.config.prepDuration}s</span>
              </div>
              <div class="timing-item">
                <span class="timing-label">Work</span>
                <span class="timing-value">${routine.config.workDuration}s</span>
              </div>
              <div class="timing-item">
                <span class="timing-label">Rest</span>
                <span class="timing-value">${routine.config.restDuration}s</span>
              </div>
              <div class="timing-item">
                <span class="timing-label" data-i18n="Rounds">Rounds</span>
                <span class="timing-value">${routine.config.rounds}</span>
              </div>
            </div>
          </div>
        </article>
      `;
      })
      .join("");

    initTranslation(list);

    // Setup routine card click and keydown handlers
    list.querySelectorAll(".routine-card").forEach((card) => {
      const handleSelect = async () => {
        const routineId = card.getAttribute("data-routine-id");
        if (routineId) {
          await play("tap", true);
          loadRoutine(routineId);
        }
      };

      card.addEventListener("click", handleSelect);

      card.addEventListener("keydown", async (e) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === "Enter" || keyEvent.key === " ") {
          keyEvent.preventDefault();
          await handleSelect();
        }
      });
    });
  }

  // --- RENDERING EDITOR PANEL (RIGHT PANEL) ---
  function loadRoutine(routineId: string | null) {
    selectedRoutineId = routineId;

    if (!routineId) {
      currentEditingRoutine = null;
      exercisesState = [];
      updateEditorPanelUI();
      renderRoutines();
      return;
    }

    const routines = RoutineStorageService.getRoutines();
    const routine = routines.find((r) => r.id === routineId);
    if (!routine) return;

    // Clone routine and exercises state
    currentEditingRoutine = JSON.parse(JSON.stringify(routine));
    exercisesState = [...(currentEditingRoutine?.exercises || [])];

    updateEditorPanelUI();
    renderRoutines();
  }

  function startNewRoutine() {
    selectedRoutineId = ""; // empty ID represents new unsaved routine
    currentEditingRoutine = {
      id: "",
      name: t("New Routine"),
      config: {
        prepDuration: 10,
        workDuration: 20,
        restDuration: 10,
        rounds: 8,
        nextExercise: 0,
      },
      exercises: [],
    };
    exercisesState = [];

    updateEditorPanelUI();
    renderRoutines();

    // Focus routine name input
    const nameInput = document.getElementById(
      "editor-routine-name",
    ) as HTMLInputElement | null;
    if (nameInput) {
      nameInput.focus();
    }
  }

  function updateEditorPanelUI() {
    const placeholder = document.getElementById("editor-placeholder");
    const content = document.getElementById("editor-content");

    if (!placeholder || !content) return;

    if (!currentEditingRoutine) {
      placeholder.style.display = "flex";
      content.style.display = "none";
      return;
    }

    placeholder.style.display = "none";
    content.style.display = "block";

    // Header Title
    const title = document.getElementById("editor-title");
    if (title) {
      title.textContent = currentEditingRoutine.id
        ? t("Edit Routine")
        : t("New Routine");
    }

    // Hide share and delete buttons for new unsaved routines
    const btnShare = document.getElementById("editor-btn-share");
    const btnDelete = document.getElementById("editor-btn-delete");
    if (btnShare) {
      btnShare.style.display = currentEditingRoutine.id
        ? "inline-flex"
        : "none";
    }
    if (btnDelete) {
      btnDelete.style.display = currentEditingRoutine.id
        ? "inline-flex"
        : "none";
    }

    // Input fields
    const nameInput = document.getElementById(
      "editor-routine-name",
    ) as HTMLInputElement | null;
    const prepInput = document.getElementById(
      "editor-prep",
    ) as HTMLInputElement | null;
    const workInput = document.getElementById(
      "editor-work",
    ) as HTMLInputElement | null;
    const restInput = document.getElementById(
      "editor-rest",
    ) as HTMLInputElement | null;
    const roundsInput = document.getElementById(
      "editor-rounds",
    ) as HTMLInputElement | null;
    const isActiveCheckbox = document.getElementById(
      "editor-is-active",
    ) as HTMLInputElement | null;

    if (nameInput) nameInput.value = currentEditingRoutine.name;
    if (prepInput)
      prepInput.value = currentEditingRoutine.config.prepDuration.toString();
    if (workInput)
      workInput.value = currentEditingRoutine.config.workDuration.toString();
    if (restInput)
      restInput.value = currentEditingRoutine.config.restDuration.toString();
    if (roundsInput)
      roundsInput.value = currentEditingRoutine.config.rounds.toString();

    // Checkbox is active
    if (isActiveCheckbox) {
      const activeId = RoutineStorageService.getActiveRoutineId();
      isActiveCheckbox.checked = currentEditingRoutine.id === activeId;
    }

    // Badge
    const badge = document.getElementById("exercises-badge");
    if (badge) badge.textContent = exercisesState.length.toString();

    // Exercises List
    renderEditorExercisesList();
  }

  function renderEditorExercisesList() {
    const listContainer = document.getElementById("editor-exercises-list");
    if (!listContainer) return;

    if (exercisesState.length === 0) {
      listContainer.innerHTML = `
        <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted);" data-i18n="No exercises added yet. Start your routine!">
          ${t("No exercises added yet. Start your routine!")}
        </div>
      `;
      return;
    }

    listContainer.innerHTML = exercisesState
      .map((exercise, index) => {
        const isFirst = index === 0;
        const isLast = index === exercisesState.length - 1;

        return `
        <div class="editor-exercise-item" data-index="${index}">
          <div class="exercise-info">
            <span class="exercise-index">${index + 1}.</span>
            <span class="exercise-text">${escapeHtml(exercise)}</span>
          </div>
          <div class="exercise-actions">
            <button type="button" class="btn-move-up" ${isFirst ? "disabled" : ""}
              title="Move exercise up"
              aria-label="Move exercise up"
              data-i18n-title="Move exercise up"
              data-i18n-aria-label="Move exercise up"
              data-tooltip="Move exercise up">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="18 15 12 9 6 15"></polyline>
              </svg>
            </button>
            <button type="button" class="btn-move-down" ${isLast ? "disabled" : ""}
              title="Move exercise down"
              aria-label="Move exercise down"
              data-i18n-title="Move exercise down"
              data-i18n-aria-label="Move exercise down"
              data-tooltip="Move exercise down">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <button type="button" class="btn-duplicate-exercise"
              title="Duplicate exercise"
              aria-label="Duplicate exercise"
              data-i18n-title="Duplicate exercise"
              data-i18n-aria-label="Duplicate exercise"
              data-tooltip="Duplicate exercise">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </button>
            <button type="button" class="btn-edit-exercise"
              title="Edit exercise"
              aria-label="Edit exercise"
              data-i18n-title="Edit exercise"
              data-i18n-aria-label="Edit exercise"
              data-tooltip="Edit exercise">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
            </button>
            <button type="button" class="delete-exercise"
              title="Delete exercise"
              aria-label="Delete exercise"
              data-i18n-title="Delete exercise"
              data-i18n-aria-label="Delete exercise"
              data-tooltip="Delete exercise">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
            </button>
          </div>
        </div>
      `;
      })
      .join("");

    initTranslation(listContainer);

    // Bind exercise-item action buttons
    listContainer.querySelectorAll(".editor-exercise-item").forEach((item) => {
      const idx = parseInt(item.getAttribute("data-index") || "0");

      item
        .querySelector(".btn-move-up")
        ?.addEventListener("click", async () => {
          await play("tap", true);
          moveExercise(idx, idx - 1);
        });

      item
        .querySelector(".btn-move-down")
        ?.addEventListener("click", async () => {
          await play("tap", true);
          moveExercise(idx, idx + 1);
        });

      item
        .querySelector(".btn-duplicate-exercise")
        ?.addEventListener("click", async () => {
          await play("tap", true);
          duplicateExercise(idx);
        });

      item
        .querySelector(".btn-edit-exercise")
        ?.addEventListener("click", async (e) => {
          await play("tap", true);
          openEditExerciseModal(idx, e.currentTarget as HTMLElement);
        });

      item
        .querySelector(".delete-exercise")
        ?.addEventListener("click", async () => {
          await play("tap", true);
          deleteExercise(idx);
        });
    });
  }

  // --- ACTIONS ---
  function moveExercise(from: number, to: number) {
    if (to < 0 || to >= exercisesState.length) return;
    const item = exercisesState[from];
    exercisesState.splice(from, 1);
    exercisesState.splice(to, 0, item);

    // Update state & UI
    const badge = document.getElementById("exercises-badge");
    if (badge) badge.textContent = exercisesState.length.toString();
    renderEditorExercisesList();
  }

  function duplicateExercise(idx: number) {
    const item = exercisesState[idx];
    exercisesState.splice(idx + 1, 0, item);

    const badge = document.getElementById("exercises-badge");
    if (badge) badge.textContent = exercisesState.length.toString();
    renderEditorExercisesList();
  }

  function deleteExercise(idx: number) {
    exercisesState.splice(idx, 1);

    const badge = document.getElementById("exercises-badge");
    if (badge) badge.textContent = exercisesState.length.toString();
    renderEditorExercisesList();
  }

  function addExercise() {
    const input = document.getElementById(
      "new-exercise-input",
    ) as HTMLInputElement | null;
    if (!input) return;

    const name = input.value.trim();
    if (!name) return;

    exercisesState.push(name);
    input.value = "";

    const badge = document.getElementById("exercises-badge");
    if (badge) badge.textContent = exercisesState.length.toString();
    renderEditorExercisesList();

    // Keep focus on input for fast typing
    input.focus();
  }

  // --- EXERCISE MODAL ---
  function openEditExerciseModal(idx: number, trigger: HTMLElement) {
    if (!exerciseModal || !exerciseModalInput) return;
    activeEditingExerciseIndex = idx;
    exerciseModalInput.value = exercisesState[idx];
    exerciseModal.showModal();
    exerciseModalInput.focus();

    exerciseModal.addEventListener(
      "close",
      () => {
        trigger.focus();
      },
      { once: true },
    );
  }

  // --- SAVE / DELETE / SHARE MAIN ROUTINE ---
  async function saveRoutine() {
    if (!currentEditingRoutine) return;

    const nameInput = document.getElementById(
      "editor-routine-name",
    ) as HTMLInputElement | null;
    const prepInput = document.getElementById(
      "editor-prep",
    ) as HTMLInputElement | null;
    const workInput = document.getElementById(
      "editor-work",
    ) as HTMLInputElement | null;
    const restInput = document.getElementById(
      "editor-rest",
    ) as HTMLInputElement | null;
    const roundsInput = document.getElementById(
      "editor-rounds",
    ) as HTMLInputElement | null;
    const isActiveCheckbox = document.getElementById(
      "editor-is-active",
    ) as HTMLInputElement | null;

    const name = nameInput?.value.trim() || "";
    if (!name) {
      alert(t("Routine Name") + " " + "is required");
      return;
    }

    const config = {
      prepDuration: parseInt(prepInput?.value || "10") || 0,
      workDuration: parseInt(workInput?.value || "20") || 0,
      restDuration: parseInt(restInput?.value || "10") || 0,
      rounds: parseInt(roundsInput?.value || "8") || 1,
      nextExercise: 0,
    };

    let savedRoutine: Routine;

    if (currentEditingRoutine.id) {
      // Edit existing
      RoutineStorageService.updateRoutine(currentEditingRoutine.id, {
        name,
        config,
        exercises: exercisesState,
      });
      savedRoutine = {
        id: currentEditingRoutine.id,
        name,
        config,
        exercises: exercisesState,
      };
    } else {
      // Create new
      savedRoutine = RoutineStorageService.createRoutine(
        name,
        config,
        exercisesState,
      );
    }

    // Set Active State if checkbox checked
    if (isActiveCheckbox?.checked) {
      RoutineStorageService.setActiveRoutineId(savedRoutine.id);
    } else {
      // If was previously active, but unchecked (and other routines exist)
      const currentActiveId = RoutineStorageService.getActiveRoutineId();
      if (currentActiveId === savedRoutine.id && !isActiveCheckbox?.checked) {
        // select another routine if possible
        const list = RoutineStorageService.getRoutines().filter(
          (r) => r.id !== savedRoutine.id,
        );
        if (list.length > 0) {
          RoutineStorageService.setActiveRoutineId(list[0].id);
        } else {
          RoutineStorageService.setActiveRoutineId("");
        }
      }
    }

    // Re-select and re-render
    selectedRoutineId = savedRoutine.id;
    searchQuery = ""; // clear search on save to show saved routine
    const searchField = document.querySelector(
      ".search-input",
    ) as HTMLInputElement | null;
    if (searchField) {
      searchField.value = "";
      const clearBtn = document.getElementById("clear-search");
      if (clearBtn) clearBtn.style.display = "none";
    }

    loadRoutine(savedRoutine.id);
  }

  async function shareRoutine() {
    if (!currentEditingRoutine) return;

    const btn = document.getElementById(
      "editor-btn-share",
    ) as HTMLButtonElement | null;
    if (btn && btn.getAttribute("data-feedback-active") === "true") return;

    await play("tap", true);

    const routineToShare: Routine = {
      id: currentEditingRoutine.id || "temp",
      name:
        (
          document.getElementById("editor-routine-name") as HTMLInputElement
        )?.value.trim() || currentEditingRoutine.name,
      config: {
        prepDuration:
          parseInt(
            (document.getElementById("editor-prep") as HTMLInputElement)
              ?.value || "10",
          ) || 0,
        workDuration:
          parseInt(
            (document.getElementById("editor-work") as HTMLInputElement)
              ?.value || "20",
          ) || 0,
        restDuration:
          parseInt(
            (document.getElementById("editor-rest") as HTMLInputElement)
              ?.value || "10",
          ) || 0,
        rounds:
          parseInt(
            (document.getElementById("editor-rounds") as HTMLInputElement)
              ?.value || "8",
          ) || 1,
        nextExercise: 0,
      },
      exercises: exercisesState,
    };

    const result = compressRoutine(routineToShare);
    if (result.success && result.url) {
      if (navigator.share) {
        try {
          await navigator.share({
            title: routineToShare.name,
            text: t("Share routine"),
            url: result.url,
          });
        } catch (err) {
          if ((err as Error).name !== "AbortError") {
            await navigator.clipboard.writeText(result.url);
            showCopyFeedback(btn);
          }
        }
      } else {
        await navigator.clipboard.writeText(result.url);
        showCopyFeedback(btn);
      }
    } else {
      alert(t("Failed to generate link"));
    }
  }

  function showCopyFeedback(btn: HTMLButtonElement | null) {
    if (!btn) return;
    btn.setAttribute("data-feedback-active", "true");

    const originalHtml = btn.innerHTML;
    const originalTitle = btn.getAttribute("title");
    const originalAria = btn.getAttribute("aria-label");
    const originalTooltip = btn.getAttribute("data-tooltip");

    const successMsg = t("Link copied to clipboard");

    btn.innerHTML = "✓";
    btn.setAttribute("title", successMsg);
    btn.setAttribute("aria-label", successMsg);
    btn.setAttribute("data-tooltip", successMsg);

    setTimeout(() => {
      btn.innerHTML = originalHtml;
      if (originalTitle !== null) btn.setAttribute("title", originalTitle);
      else btn.removeAttribute("title");
      if (originalAria !== null) btn.setAttribute("aria-label", originalAria);
      else btn.removeAttribute("aria-label");
      if (originalTooltip !== null)
        btn.setAttribute("data-tooltip", originalTooltip);
      else btn.removeAttribute("data-tooltip");
      btn.removeAttribute("data-feedback-active");
    }, 2000);
  }

  async function deleteRoutine() {
    if (!currentEditingRoutine || !currentEditingRoutine.id) return;

    await play("tap", true);

    if (
      confirm(
        t('Are you sure you want to delete "{name}"?').replace(
          "{name}",
          currentEditingRoutine.name,
        ),
      )
    ) {
      RoutineStorageService.deleteRoutine(currentEditingRoutine.id);

      // Select first routine in the collection, or reset
      const remaining = RoutineStorageService.getRoutines();
      if (remaining.length > 0) {
        loadRoutine(remaining[0].id);
      } else {
        loadRoutine(null);
      }
    }
  }

  // --- INITIALIZATION ---
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Initial Render
    const allRoutines = RoutineStorageService.getRoutines();
    const activeId = RoutineStorageService.getActiveRoutineId();

    if (activeId && allRoutines.some((r) => r.id === activeId)) {
      loadRoutine(activeId);
    } else if (allRoutines.length > 0) {
      loadRoutine(allRoutines[0].id);
    } else {
      loadRoutine(null);
    }

    // 2. Bind New Routine button click
    const btnNewRoutine = document.getElementById("btn-new-routine");
    btnNewRoutine?.addEventListener("click", async () => {
      await play("tap", true);
      startNewRoutine();
    });

    // 3. Search listener
    document.addEventListener("search", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      searchQuery = detail.query;
      renderRoutines();
    });

    const btnClearSearchEmpty = document.getElementById(
      "btn-clear-search-empty",
    );
    btnClearSearchEmpty?.addEventListener("click", () => {
      const clearBtn = document.getElementById("clear-search");
      if (clearBtn) {
        clearBtn.click();
      }
    });

    // 4. Bind Exercise Adding
    const btnAddExercise = document.getElementById("btn-add-exercise");
    const exerciseInput = document.getElementById("new-exercise-input");

    btnAddExercise?.addEventListener("click", async () => {
      await play("tap", true);
      addExercise();
    });

    exerciseInput?.addEventListener("keypress", async (e) => {
      if ((e as KeyboardEvent).key === "Enter") {
        e.preventDefault();
        await play("tap", true);
        addExercise();
      }
    });

    // 5. Bind Exercise Modal Actions
    exerciseModalForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      await play("tap", true);
      if (activeEditingExerciseIndex !== null && exerciseModalInput) {
        const val = exerciseModalInput.value.trim();
        if (val) {
          exercisesState[activeEditingExerciseIndex] = val;
          renderEditorExercisesList();
        }
      }
      exerciseModal?.close();
    });

    const btnCancelExerciseModal = document.getElementById(
      "exercise-modal-cancel",
    );
    btnCancelExerciseModal?.addEventListener("click", async () => {
      await play("tap", true);
      exerciseModal?.close();
    });

    exerciseModal?.addEventListener("click", (e) => {
      if (e.target === exerciseModal) {
        exerciseModal.close();
      }
    });

    // 6. Bind Editor Header Share/Delete buttons
    const btnShare = document.getElementById("editor-btn-share");
    btnShare?.addEventListener("click", () => {
      shareRoutine();
    });

    const btnDelete = document.getElementById("editor-btn-delete");
    btnDelete?.addEventListener("click", () => {
      deleteRoutine();
    });

    // 7. Bind Editor Footer Cancel/Save buttons
    const btnCancel = document.getElementById("editor-btn-cancel");
    btnCancel?.addEventListener("click", async () => {
      await play("tap", true);
      loadRoutine(selectedRoutineId);
    });

    const btnSave = document.getElementById("editor-btn-save");
    btnSave?.addEventListener("click", async (e) => {
      e.preventDefault();
      await play("tap", true);
      saveRoutine();
    });
  });
</script>

