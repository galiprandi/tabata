---
import Layout from "@app/layouts/layout.astro";
import Play from "@icons/Play.icon.astro";
import Continue from "@components/icons/Continue.icon.astro";
import Pause from "@icons/Pause.icon.astro";
import GoToSettings from "@components/GoToSettings.astro";
import GoToHome from "@components/GoToHome.astro";
---

<Layout>
  <!-- Main workout display -->
  <div id="workout-screen">
    <!-- Phase indicator (prep/work/rest) -->
    <div id="phase-indicator" class="phase-indicator"></div>

    <!-- Round dots -->
    <div id="round-dots" class="round-dots"></div>

    <!-- Exercise name - giant, centered -->
    <div id="exercise-display" class="exercise-display speech">
      <span id="exercise-name" data-i18n="Preparation Time"
        >Preparation Time</span
      >
    </div>

    <!-- Timer - giant countdown -->
    <div id="timer-display" class="timer-display">
      <span id="time-remaining">-</span>
    </div>

    <!-- Progress bar - full width -->
    <div class="progress-bar-container">
      <div id="progress-bar" class="progress-bar"></div>
    </div>

    <!-- Next exercise preview -->
    <div id="next-exercise-preview" class="next-exercise-preview">
      <span class="next-label" data-i18n="Next:">Next:</span>
      <span id="next-exercise-name">-</span>
    </div>

    <!-- Pause button (visible but whole screen is tappable) -->
    <button
      id="btn-pause"
      class="btn-pause"
      aria-label="Pause"
      title="Pause (Space)"
      data-i18n-aria-label="Pause"
      data-i18n-title="Pause (Space)"
      data-tooltip="Pause (Space)"
    >
      <Pause />
    </button>
  </div>

  <!-- Start modal - dismissible overlay, not blocking dialog -->
  <div id="start-overlay" class="start-overlay">
    <div class="start-card">
      <h2 class="start-title" data-i18n="Routine">Routine</h2>

      <div class="routine-info">
        <div class="info-item">
          <span class="info-value" id="total-exercises">-</span>
          <span class="info-label" data-i18n="Exercises">Exercises</span>
        </div>
        <div class="info-item">
          <span class="info-value" id="total-rounds">-</span>
          <span class="info-label" data-i18n="Rounds">Rounds</span>
        </div>
        <div class="info-item">
          <span class="info-value" id="total-time">-</span>
          <span class="info-label" data-i18n="Time">Time</span>
        </div>
      </div>

      <div class="start-actions">
        <button id="btn-restart" class="btn-secondary">
          <Play />
          <span data-i18n="Restart">Restart</span>
        </button>
        <button id="btn-continue" class="btn-primary">
          <Continue />
          <span data-i18n="Continue">Continue</span>
        </button>
      </div>

      <div class="keyboard-hint" data-i18n="Press Enter or Space to Continue">
        Press Enter or Space to Continue
      </div>

      <div class="start-secondary">
        <GoToHome />
        <GoToSettings />
      </div>
    </div>
  </div>

  <!-- Pause overlay -->
  <div id="pause-overlay" class="pause-overlay" style="display: none;">
    <div class="pause-card">
      <h2 class="pause-title" data-i18n="Paused">Paused</h2>
      <div class="pause-actions">
        <button id="btn-resume" class="btn-primary">
          <Continue />
          <span data-i18n="Resume">Resume</span>
        </button>
        <button id="btn-restart-pause" class="btn-secondary">
          <Play />
          <span data-i18n="Restart">Restart</span>
        </button>
        <button id="btn-exit" class="btn-exit">
          <span data-i18n="Exit">Exit</span>
        </button>
      </div>

      <div class="keyboard-hint" data-i18n="Press Space to Resume, Esc to Exit">
        Press Space to Resume, Esc to Exit
      </div>
    </div>
  </div>
</Layout>

<script>
  import { play } from "@assets/audio";
  import { t } from "@assets/dictionary";
  import { switchBodyClass, formatDuration, onClick } from "@assets/domHelpers";
  import { textToSpeech, updateTextContent, gaEvent } from "@assets/main";
  import { RoutineService } from "@assets/routine/RoutineService";
  import { TimerController, hapticFeedback } from "@assets/timerController";

  let timer = new TimerController();
  let isWorkoutRunning = false;
  let originalTitle = "Tabata";

  // Wait for the DOM to be ready
  document.addEventListener("DOMContentLoaded", () => {
    originalTitle = document.title || "Tabata";
    const config = RoutineService.getConfig();
    updateRoutineInfo(config);
    renderRoundDots(config.rounds, 0);

    // Initial focus on continue button
    const btnContinue = document.getElementById(
      "btn-continue",
    ) as HTMLButtonElement | null;
    btnContinue?.focus();

    onClick("#btn-pause", () => {
      if (isWorkoutRunning) {
        pauseWorkout();
      }
    });

    onClick("#btn-restart", () => {
      RoutineService.updateConfig({ nextExercise: 0 });
      startWorkout();
    });

    onClick("#btn-continue", startWorkout);

    onClick("#btn-resume", resumeWorkout);

    // Tap anywhere on pause overlay backdrop to resume
    const pauseOverlay = document.getElementById("pause-overlay");
    pauseOverlay?.addEventListener("click", (e) => {
      if (e.target === pauseOverlay) {
        resumeWorkout();
      }
    });

    onClick("#btn-restart-pause", () => {
      hidePauseOverlay();
      timer.abort();
      document.title = originalTitle;
      RoutineService.updateConfig({ nextExercise: 0 });
      setTimeout(() => startWorkout(), 100);
    });
    onClick("#btn-exit", () => {
      timer.abort();
      document.title = originalTitle;
      window.location.href = "/tabata";
    });

    // Tap anywhere on workout screen to pause (except buttons)
    const workoutScreen = document.getElementById("workout-screen");
    workoutScreen?.addEventListener("click", (e) => {
      if (!isWorkoutRunning) return;
      const target = e.target as HTMLElement;
      if (target.closest("button")) return;
      pauseWorkout();
    });

    // Keyboard controls
    document.addEventListener("keydown", (e) => {
      const startOverlay = document.getElementById("start-overlay");
      const pauseOverlay = document.getElementById("pause-overlay");

      const isStartVisible =
        startOverlay &&
        window.getComputedStyle(startOverlay).display !== "none";
      const isPauseVisible =
        pauseOverlay &&
        window.getComputedStyle(pauseOverlay).display !== "none";
      const isButtonFocused = e.target instanceof HTMLButtonElement;

      if (e.code === "Space") {
        if (isButtonFocused) return;
        e.preventDefault();
        if (isStartVisible) {
          startWorkout();
        } else if (isPauseVisible) {
          resumeWorkout();
        } else if (isWorkoutRunning) {
          pauseWorkout();
        }
      } else if (e.key === "Enter") {
        if (isButtonFocused) return;
        if (isStartVisible) {
          e.preventDefault();
          startWorkout();
        }
      } else if (e.key === "Escape") {
        if (isPauseVisible) {
          resumeWorkout();
        } else if (isWorkoutRunning) {
          pauseWorkout();
        } else if (isStartVisible) {
          document.title = originalTitle;
          window.location.href = "/tabata";
        }
      }
    });

    // Swipe gestures
    setupSwipeGestures();
  });

  function setupSwipeGestures() {
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTime = 0;

    document.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
      },
      { passive: true },
    );

    document.addEventListener(
      "touchend",
      (e) => {
        if (!isWorkoutRunning) return;

        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const dx = touchEndX - touchStartX;
        const dy = touchEndY - touchStartY;
        const dt = Date.now() - touchStartTime;

        // Swipe = horizontal movement > 100px, less than 50px vertical, under 500ms
        if (Math.abs(dx) > 100 && Math.abs(dy) < 50 && dt < 500) {
          if (dx < 0) {
            // Swipe left = restart
            timer.abort();
            RoutineService.updateConfig({ nextExercise: 0 });
            setTimeout(() => startWorkout(), 100);
          } else {
            // Swipe right = skip rest (advance to next exercise)
            // Only skip if currently in rest phase
            if (document.body.classList.contains("rest")) {
              timer.abort();
            }
          }
        }
      },
      { passive: true },
    );
  }

  function updateRoutineInfo(config: any) {
    const exercises = RoutineService.getExercises();
    const secondsByExercise = config.workDuration + config.restDuration;
    const totalTime =
      config.prepDuration +
      secondsByExercise * config.rounds * exercises.length;

    updateTextContent("#total-exercises", exercises.length.toString());
    updateTextContent("#total-rounds", config.rounds.toString());
    updateTextContent("#total-time", formatDuration(totalTime));
  }

  function renderRoundDots(totalRounds: number, currentRound: number) {
    const container = document.getElementById("round-dots");
    if (!container) return;

    let dots = "";
    for (let i = 0; i < totalRounds; i++) {
      const completed = i < currentRound;
      const current = i === currentRound;
      dots += `<span class="dot ${completed ? "completed" : ""} ${current ? "current" : ""}"></span>`;
    }
    container.innerHTML = dots;
  }

  function updatePhaseIndicator(phase: string) {
    const indicator = document.getElementById("phase-indicator");
    if (!indicator) return;

    const labels: Record<string, string> = {
      prep: t("Preparation Time"),
      workout: t("Work"),
      rest: t("Rest"),
    };
    indicator.textContent = labels[phase] || phase;
    indicator.className = `phase-indicator phase-${phase}`;
  }

  function updateNextExercisePreview() {
    const config = RoutineService.getConfig();
    const exercises = RoutineService.getExercises();
    let nextIndex = config.nextExercise + 1;
    if (nextIndex >= exercises.length) nextIndex = 0;
    const nextExercise = exercises[nextIndex];
    if (nextExercise) {
      updateTextContent("#next-exercise-name", nextExercise);
    }
  }

  function updateProgressBar(percent: number) {
    const bar = document.getElementById("progress-bar");
    if (bar) {
      bar.style.width = `${percent}%`;
    }
  }

  function pauseWorkout() {
    if (!isWorkoutRunning) return;
    timer.pause();
    play("tap", true);
    hapticFeedback(30);
    showPauseOverlay();
    document.title = `[Paused] ${document.title.replace(/^\[Paused\]\s*/, "")}`;
  }

  function resumeWorkout() {
    hidePauseOverlay();
    play("tap", true);
    hapticFeedback(30);
    timer.resume();
  }

  function showPauseOverlay() {
    const overlay = document.getElementById("pause-overlay");
    if (overlay) {
      overlay.style.display = "flex";
      const btnResume = document.getElementById(
        "btn-resume",
      ) as HTMLButtonElement | null;
      btnResume?.focus();
    }
  }

  function hidePauseOverlay() {
    const overlay = document.getElementById("pause-overlay");
    if (overlay) {
      overlay.style.display = "none";
      const btnPause = document.getElementById(
        "btn-pause",
      ) as HTMLButtonElement | null;
      btnPause?.focus();
    }
  }

  function hideStartOverlay() {
    const overlay = document.getElementById("start-overlay");
    if (overlay) {
      overlay.style.display = "none";
      const btnPause = document.getElementById(
        "btn-pause",
      ) as HTMLButtonElement | null;
      btnPause?.focus();
    }
  }

  async function startWorkout() {
    hideStartOverlay();
    play("tap", true);
    timer = new TimerController();
    isWorkoutRunning = true;
    gaEvent("Start Workout");
    await runRoutine();
  }

  async function runRoutine() {
    const config = RoutineService.getConfig();

    try {
      // Preparation time
      await prepTime();

      // Loop through rounds
      for (let round = 1; round <= config.rounds; round++) {
        await workTime(round);
        if (round < config.rounds) {
          await restTime(round);
        }
      }

      // End of routine
      routineCompleted();
    } catch (e) {
      // Timer was aborted (restart or exit) - silently handle
      if (e instanceof Error && e.message === "TIMER_ABORTED") {
        return;
      }
      throw e;
    }
  }

  async function prepTime() {
    const config = RoutineService.getConfig();
    const exercises = RoutineService.getExercises();
    const exercise = exercises[config.nextExercise] ?? `${t("Exercise")} 1`;

    switchBodyClass("prep");
    updatePhaseIndicator("prep");
    updateTextContent("#exercise-name", exercise);
    updateTextContent("#next-exercise-name", exercise);
    textToSpeech(`${t("First Exercise")}: ${exercise}`);
    hapticFeedback(100);

    for (let sec = config.prepDuration; sec > 0; sec--) {
      updateTextContent("#time-remaining", sec.toString());
      document.title = `[Prep ${sec}s] ${exercise} | ${originalTitle}`;
      updateProgressBar((sec / config.prepDuration) * 100);
      if (sec <= 3 && sec >= 1) {
        await play("beep");
        hapticFeedback(50);
      }
      await timer.delay(1);
    }
  }

  async function workTime(round: number) {
    const exercises = RoutineService.getExercises();
    const config = RoutineService.getConfig();
    const exercise =
      exercises[config.nextExercise] ?? `${t("Exercise")} ${round}`;

    switchBodyClass("workout");
    updatePhaseIndicator("workout");
    updateTextContent("#exercise-name", exercise);
    renderRoundDots(config.rounds, round - 1);
    updateNextExercisePreview();
    textToSpeech(t("Go!"));
    hapticFeedback([50, 30, 50]);

    for (let sec = config.workDuration; sec > 0; sec--) {
      updateTextContent("#time-remaining", sec.toString());
      document.title = `[Work ${sec}s] ${exercise} | ${originalTitle}`;
      updateProgressBar((sec / config.workDuration) * 100);
      if (sec <= 3 && sec >= 1) {
        await play("beep");
        hapticFeedback(50);
      }
      await timer.delay(1);
    }

    forwardToNextExercise();
  }

  async function restTime(round: number) {
    const exercises = RoutineService.getExercises();
    const config = RoutineService.getConfig();
    const exercise =
      exercises[config.nextExercise] ?? `${t("Exercise")} ${round + 1}`;

    switchBodyClass("rest");
    updatePhaseIndicator("rest");
    updateTextContent("#exercise-name", exercise);
    updateNextExercisePreview();
    textToSpeech(`${t("Next")}, ${exercise}`);
    hapticFeedback(100);

    for (let sec = config.restDuration; sec > 0; sec--) {
      updateTextContent("#time-remaining", sec.toString());
      document.title = `[Rest ${sec}s] ${exercise} | ${originalTitle}`;
      updateProgressBar((sec / config.restDuration) * 100);
      if (sec <= 3 && sec >= 1) {
        await play("beep");
        hapticFeedback(50);
      }
      await timer.delay(1);
    }
  }

  async function routineCompleted() {
    isWorkoutRunning = false;
    document.title = originalTitle;
    await play("end");
    hapticFeedback([100, 50, 100, 50, 200]);
    await timer.delay(1);
    textToSpeech(t("Routine completed!"));
    window.location.href = "/tabata/end";
  }

  function forwardToNextExercise() {
    const config = RoutineService.getConfig();
    const exercises = RoutineService.getExercises();
    let nextIndex = config.nextExercise + 1;
    if (nextIndex >= exercises.length) nextIndex = 0;
    RoutineService.updateConfig({ nextExercise: nextIndex });
  }
</script>

<style>
  #workout-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    position: relative;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Phase indicator */
  .phase-indicator {
    font-size: clamp(0.9rem, 3vw, 1.2rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.7;
    padding: 0.5rem 1.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.2);
    margin-top: 0.5rem;
  }

  .phase-indicator.phase-prep {
    color: #7dd3fc;
  }
  .phase-indicator.phase-workout {
    color: #fff;
  }
  .phase-indicator.phase-rest {
    color: #fca5a5;
  }

  /* Round dots */
  .round-dots {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 90vw;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: all 0.3s;
  }

  .dot.completed {
    background: rgba(255, 255, 255, 0.6);
  }

  .dot.current {
    background: white;
    transform: scale(1.4);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
  }

  /* Exercise name - GIANT */
  .exercise-display {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0 1rem;
  }

  #exercise-name {
    font-size: clamp(2.5rem, 11vw, 7rem);
    font-weight: 900;
    line-height: 1.05;
    text-align: center;
    word-break: break-word;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  /* Timer - GIANT */
  .timer-display {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.5rem 0;
  }

  #time-remaining {
    font-size: clamp(4rem, 18vw, 12rem);
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.4);
  }

  /* Progress bar - full width */
  .progress-bar-container {
    width: 100%;
    height: 6px;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
    overflow: hidden;
    margin: 0.5rem 0;
  }

  .progress-bar {
    height: 100%;
    width: 100%;
    background: white;
    border-radius: 3px;
    transition: width 0.3s ease-out;
  }

  /* Next exercise preview */
  .next-exercise-preview {
    font-size: clamp(0.85rem, 2.5vw, 1rem);
    opacity: 0.5;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .next-label {
    margin-right: 0.3rem;
  }

  /* Pause button - top-left to avoid overlap with audio control (top-right) */
  .btn-pause {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition:
      transform 0.2s,
      background 0.2s;
    backdrop-filter: blur(4px);
  }

  .btn-pause:active {
    transform: scale(0.92);
    background: rgba(0, 0, 0, 0.5);
  }

  .btn-pause svg {
    width: 24px;
    height: 24px;
  }

  /* Start overlay */
  .start-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .start-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 2rem;
    max-width: 400px;
    width: 100%;
    text-align: center;
  }

  .start-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin: 0 0 1.5rem 0;
  }

  .routine-info {
    display: flex;
    justify-content: space-around;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .info-value {
    font-size: 2rem;
    font-weight: 800;
    color: white;
  }

  .info-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 0.25rem;
  }

  .start-actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .start-actions button {
    flex: 1;
    min-height: 56px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition:
      transform 0.15s,
      opacity 0.2s;
  }

  .start-actions button:active {
    transform: scale(0.96);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color--prep);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .start-secondary {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .start-secondary :global(button) {
    min-width: 48px;
    min-height: 48px;
    padding: 0.5rem;
  }

  /* Pause overlay */
  .pause-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .pause-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 2rem;
    max-width: 360px;
    width: 100%;
    text-align: center;
  }

  .pause-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    margin: 0 0 1.5rem 0;
  }

  .pause-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pause-actions button {
    min-height: 56px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: transform 0.15s;
  }

  .pause-actions button:active {
    transform: scale(0.96);
  }

  .btn-exit {
    background: transparent;
    color: var(--color-rest);
    border: 1px solid var(--color-rest) !important;
  }

  /* Landscape optimization */
  @media (orientation: landscape) and (max-height: 500px) {
    .phase-indicator {
      font-size: 0.85rem;
      margin-top: 0;
    }

    .round-dots {
      margin-top: 0.25rem;
    }

    .exercise-display {
      padding: 0 2rem;
    }

    #exercise-name {
      font-size: clamp(2rem, 8vw, 5rem);
    }

    #time-remaining {
      font-size: clamp(3rem, 14vh, 8rem);
    }

    .next-exercise-preview {
      margin-bottom: 0;
    }

    .start-card,
    .pause-card {
      padding: 1.25rem;
    }
  }

  /* Very small screens */
  @media (max-width: 320px) {
    #exercise-name {
      font-size: 2rem;
    }
    #time-remaining {
      font-size: 3.5rem;
    }
  }

