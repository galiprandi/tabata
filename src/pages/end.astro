---
import Layout from '@app/layouts/layout.astro'
import BackToHome from '@components/BackToHome.astro'
---

<Layout>
  <section class="display">
    <h1>🎉 Congrats 🎉</h1>
  </section>

  <footer>
    <div class="columns">
      <button id="startAgain">Start Again</button>
      <BackToHome />
    </div>
  </footer>
</Layout>

<script is:inline>
  import { play } from '@assets/audio'
  import { RoutineStorageService } from '../assets/routine'
  import { WorkoutLogService } from '../assets/workoutLog'
  
  document.addEventListener('DOMContentLoaded', () => {
    play('end')
    
    // Register workout in history
    const activeRoutineId = RoutineStorageService.getActiveRoutineId()
    if (activeRoutineId) {
      const routines = RoutineStorageService.getRoutines()
      const activeRoutine = routines.find((r) => r.id === activeRoutineId)
      
      if (activeRoutine) {
        // Calculate estimated duration
        const totalDuration = (
          activeRoutine.config.prepDuration +
          (activeRoutine.config.workDuration + activeRoutine.config.restDuration) * activeRoutine.config.rounds * activeRoutine.exercises.length
        )
        
        WorkoutLogService.addLog(activeRoutine, totalDuration)
      }
    }
    
    document.getElementById('startAgain')?.addEventListener('click', () => {
      location.href = '/tabata/start'
    })
  })
</script>

<style>
  h1 {
    color: white;
    font-size: 8vw;
    font-weight: bold;
  }

  button#start {
    min-width: 10em;
  }
</style>
